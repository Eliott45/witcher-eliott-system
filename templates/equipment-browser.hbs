<div class="witcher-picker-content">
  <div class="witcher-catalog-head">
    <div class="witcher-picker-top"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" class="witcher-picker-search" placeholder="Название, свойство или описание…" aria-label="Поиск предметов" autocomplete="off"></div>
    {{#if hasActor}}<div class="witcher-catalog-wallet"><span><i class="fa-solid fa-coins" aria-hidden="true"></i> {{actorName}} · <strong data-catalog-balance></strong></span><label>Количество <input type="number" data-catalog-quantity value="1" min="1" step="1" aria-label="Количество для добавления или покупки"></label></div>{{/if}}
  </div>
  <div class="witcher-catalog-types" role="group" aria-label="Типы предметов">{{#each facets.types}}<label><input type="checkbox" data-equipment-filter="types" value="{{id}}"><span>{{name}}</span></label>{{/each}}</div>
  <div class="witcher-catalog-active" data-catalog-active hidden><span class="witcher-catalog-active-label"><i class="fa-solid fa-filter" aria-hidden="true"></i> Фильтры:</span><div data-catalog-chips></div><button type="button" data-clear-equipment><i class="fa-solid fa-xmark" aria-hidden="true"></i> Сбросить всё</button></div>
  <p class="witcher-catalog-notice" data-catalog-notice role="status" aria-live="polite"></p>
  <div class="witcher-picker-columns">
    <aside class="witcher-picker-filters" aria-label="Фильтры предметов">
      <details open data-filter-section><summary>Свойства <b data-filter-count></b></summary><input type="search" class="witcher-facet-search" data-facet-search placeholder="Найти свойство…" aria-label="Найти свойство"><label class="witcher-facet-mode">Совпадение<select data-equipment-filter="traitMode"><option value="all">Все выбранные</option><option value="any">Любое из выбранных</option></select></label><div class="witcher-facet-options">{{#each facets.traits}}<label data-tooltip="{{description}}" data-facet="{{label}}"><input type="checkbox" data-equipment-filter="traits" value="{{label}}"> {{label}}</label>{{/each}}</div></details>
      <details data-filter-section><summary>Доступность <b data-filter-count></b></summary>{{#each facets.rarities}}<label><input type="checkbox" data-equipment-filter="rarities" value="{{id}}"> {{name}}</label>{{/each}}</details>
      <details data-filter-section><summary>Оружие <b data-filter-count></b></summary><label>Вид<select data-equipment-filter="weaponCategory"><option value="">Любой</option>{{#each facets.weaponCategories}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Хват<select data-equipment-filter="hands"><option value="">Любой</option><option value="1">Одна рука</option><option value="2">Две руки</option></select></label></details>
      <details data-filter-section><summary>Броня <b data-filter-count></b></summary><label>Класс<select data-equipment-filter="armorClass"><option value="">Любой</option>{{#each facets.armorClasses}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Зона<select data-equipment-filter="zone"><option value="">Любая</option>{{#each facets.zones}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label></details>
      <details data-filter-section><summary>Цена и вес <b data-filter-count></b></summary><label>Цена от<input type="number" min="0" step="0.01" data-equipment-filter="priceMin"></label><label>Цена до<input type="number" min="0" step="0.01" data-equipment-filter="priceMax"></label><label>Вес от<input type="number" min="0" step="0.001" data-equipment-filter="weightMin"></label><label>Вес до<input type="number" min="0" step="0.001" data-equipment-filter="weightMax"></label></details>
      <details data-filter-section><summary>Источник <b data-filter-count></b></summary><select data-equipment-filter="source" aria-label="Источник"><option value="">Любой</option>{{#each facets.sources}}<option value="{{this}}">{{this}}</option>{{/each}}</select></details>
      <p>{{hintKey}}</p>
    </aside>
    <section class="witcher-picker-results">
      <div class="witcher-catalog-bar"><p class="witcher-picker-count" aria-live="polite"></p><label>Сортировка<select data-equipment-filter="sort"><option value="name">Название</option><option value="price">Цена</option><option value="weight">Вес</option></select></label><label class="witcher-catalog-desc" data-tooltip="По убыванию"><input type="checkbox" data-equipment-filter="descending"><i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i></label></div>
      <p class="witcher-picker-empty" hidden>Ничего не найдено. Снимите часть фильтров выше.</p>
      <div class="witcher-picker-list">
      {{#each entries as |entry|}}<article class="witcher-picker-entry" data-entry-id="{{entry.id}}">
        <button type="button" class="witcher-picker-option witcher-catalog-view" data-catalog-action="view" aria-label="Описание: {{entry.label}}"><img src="{{entry.img}}" alt=""><span><strong>{{entry.label}}</strong><small>{{entry.groupLabel}}</small></span></button>
        <dl class="witcher-catalog-stats">{{#each entry.stats}}<div class="{{#if tone}}is-{{tone}}{{/if}}"><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
        {{#if ../hasActor}}<div class="witcher-catalog-actions"><strong data-catalog-cost>{{entry.price}} кр.</strong><span><button type="button" data-catalog-action="add" aria-label="Добавить: {{entry.label}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> Добавить</button></span><span><button type="button" data-catalog-action="buy" aria-label="Купить: {{entry.label}}"><i class="fa-solid fa-coins" aria-hidden="true"></i> Купить</button></span></div>{{/if}}
        <div class="witcher-item-traits">{{#each entry.traitDetails}}<button type="button" class="is-{{tone}}" data-catalog-trait="{{label}}" data-tooltip="{{description}} Нажмите, чтобы фильтровать по этому свойству.">{{label}}</button>{{/each}}</div>
      </article>{{/each}}
    </div></section>
  </div>
</div>
