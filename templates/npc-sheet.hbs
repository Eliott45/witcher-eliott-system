<div class="witcher-npc-layout {{#if stats.dying}}is-dying{{/if}} {{#if stats.dead}}is-dead{{/if}}">
  <header class="witcher-npc-header">
    <img class="witcher-npc-portrait" src="{{actor.img}}" data-action="creaturePortrait" alt="{{actor.name}}" data-tooltip="Изменить портрет">
    <div class="witcher-npc-identity"><small>БЕСТИАРИЙ · THE WITCHER</small>{{#if editing}}<input type="text" name="name" value="{{actor.name}}" aria-label="Имя существа">{{else}}<h1>{{actor.name}}</h1>{{/if}}
      <div class="witcher-npc-traits"><span>{{category}}</span><span>{{system.creature.difficulty}}</span><span data-tooltip="Награда за победу по бестиарию">Награда {{system.creature.reward}}</span></div>
    </div><button type="button" data-action="editCreature" class="witcher-npc-edit" aria-pressed="{{editing}}" aria-label="Редактировать существо" {{disabled (not editable)}}><i class="fa-solid fa-sliders"></i></button>
  </header>
  <nav class="witcher-npc-tabs tabs" aria-label="Разделы существа">{{#each tabs}}<button type="button" data-action="tab" data-group="creature" data-tab="{{id}}" class="{{cssClass}}"><i class="{{icon}}"></i> {{label}}</button>{{/each}}</nav>
  <div class="witcher-npc-body">
    {{#if canRestoreItems}}<div class="witcher-npc-presets"><p>У этого профиля нет снаряжения и способностей из бестиария.</p><button type="button" data-action="restoreCreatureItems" {{disabled (not editable)}}>Восстановить предметы профиля</button></div>{{/if}}
    {{#if empty}}<div class="witcher-npc-presets"><strong>С чего начнём?</strong><p>Заполните существо вручную или возьмите готовый профиль.</p><button type="button" data-action="creaturePreset" data-preset="bestiaryBandit01" {{disabled (not editable)}}>Бандит</button><button type="button" data-action="creaturePreset" data-preset="bestiaryDrowner1" {{disabled (not editable)}}>Утопец</button></div>{{/if}}
    <section class="tab {{tabs.combat.cssClass}}" data-group="creature" data-tab="combat">
      <div class="witcher-npc-resources">
        <label class="npc-hp"><span>ПУНКТЫ ЗДОРОВЬЯ</span><div><input type="number" name="system.health.value" value="{{system.health.value}}" aria-label="ПЗ существа" {{disabled (not editable)}}><span>/ {{system.health.max}}</span></div><small>Порог ранения {{stats.woundThreshold}}</small></label>
        <label class="npc-stamina"><span>ВЫНОСЛИВОСТЬ</span><div><input type="number" name="system.stamina.value" value="{{system.stamina.value}}" min="0" max="{{system.stamina.max}}" aria-label="Выносливость существа" {{disabled (not editable)}}><span>/ {{system.stamina.max}}</span></div><button type="button" data-action="creatureRecover" {{disabled (or (not editable) (not conditions.canRecover))}}>Отдых +{{stats.recovery}}</button></label>
        <div class="npc-stun"><span>УСТОЙЧИВОСТЬ</span><strong>{{stats.stun}}</strong><button type="button" data-action="creatureStun" {{disabled (or (not editable) (not conditions.canStunSave))}} data-tooltip="1d10 строго меньше УСТ. Удача не тратится.">Испытание УСТ</button></div>
      </div>
      {{#if stats.dying}}<div class="witcher-npc-danger"><strong>При смерти</strong><label>Штраф <input type="number" name="system.death.penalty" min="0" value="{{system.death.penalty}}"></label><button type="button" data-action="creatureDeath" {{disabled (not editable)}}>Испытание смерти</button></div>{{/if}}
      {{#if stats.dead}}<div class="witcher-npc-danger"><i class="fa-solid fa-skull"></i> Мёртв</div>{{/if}}
      <div class="witcher-npc-stats">{{#each attributes}}<div><span data-tooltip="{{label}}">{{name}}</span>{{#if ../editing}}<input type="number" name="system.attributes.{{key}}" value="{{base}}" min="0" max="100" aria-label="{{label}}">{{else}}<button type="button" data-action="creatureAttribute" data-attribute="{{key}}" data-tooltip="Проверка {{label}}: 1d10 + {{value}}" {{disabled (not ../editable)}}>{{value}}</button>{{/if}}</div>{{/each}}</div>
      <div class="witcher-npc-movement"><button type="button" data-action="creatureInitiative" {{disabled (not editable)}} data-tooltip="Бросить инициативу в боевом трекере">Инициатива <b>+{{stats.initiative}}</b></button><span>Бег <b>{{stats.run}} м</b></span><span>Прыжок <b>{{stats.leap}} м</b></span><span>Энергия <b>{{stats.vigor}}</b></span></div>
      <div class="witcher-npc-defense">{{#each defenses}}<button type="button" data-action="creatureDefense" data-skill="{{key}}" {{disabled (or (not ../editable) (not ../conditions.canDefend))}}>{{name}} <b>+{{total}}</b></button>{{/each}}</div>
      <div class="witcher-npc-armor">{{#each inventory.zones}}<span><img src="{{img}}" alt="">{{name}} {{#each items}}<button type="button" data-action="viewSheetItem" data-item-id="{{id}}" data-tooltip="{{name}} · ПБ {{condition.value}} / {{condition.max}}"><b>{{condition.value}}</b></button>{{else}}<b>{{../system.creature.naturalArmor}}</b>{{/each}}</span>{{/each}}</div>
      {{#if effects.length}}<div class="witcher-npc-effects">{{#each effects}}<details><summary><img src="{{img}}" alt="">{{name}}</summary><div>{{{description}}}</div><button type="button" data-action="editEffectDuration" data-effect-id="{{id}}" {{disabled (not canEditDuration)}}><i class="fa-solid fa-clock"></i> {{durationLabel}}</button>{{#if save}}<button type="button" data-action="rollEffectSave" data-effect-id="{{id}}" {{disabled (not canSave)}}>{{saveHint}}</button>{{/if}}{{#if canSaveItem}}<button type="button" data-action="saveEffectItem" data-effect-id="{{id}}">Сохранить как предмет</button>{{/if}}{{#if canRemove}}<button type="button" data-action="removeCreatureEffect" data-effect-id="{{id}}">Снять</button>{{/if}}</details>{{/each}}</div>{{/if}}
      {{> "systems/witcher-eliott-system/templates/combat-actions.hbs"}}
      <div class="witcher-npc-section-title"><h2>Особенности</h2><div><button type="button" data-action="browseEffects" {{disabled (not editable)}} data-tooltip="Добавить состояние"><i class="fa-solid fa-person-rays"></i></button><button type="button" data-action="createAbility" {{disabled (not editable)}} data-tooltip="Добавить способность"><i class="fa-solid fa-plus"></i></button></div></div>
      <div class="witcher-npc-abilities">{{#each abilities}}<details class="draggable" draggable="true" data-item-id="{{id}}"><summary>{{name}}<button type="button" data-action="viewSheetItem" data-item-id="{{id}}" aria-label="Открыть способность: {{name}}"><i class="fa-solid fa-book-open"></i></button></summary><div>{{{description}}}</div>{{#if ../editing}}<button type="button" data-action="removeSheetItem" data-item-id="{{id}}">Удалить способность</button>{{/if}}</details>{{else}}<p>Перетащите способность из компендиума или создайте свою.</p>{{/each}}</div>
      <details class="witcher-npc-skills" {{#if editing}}open{{/if}}><summary>Навыки <span>{{skills.length}}</span></summary><div>{{#each skills}}<label><button type="button" data-action="creatureSkill" data-skill="{{key}}" data-tooltip="{{calculation}}" {{disabled (not ../editable)}}>{{name}} <b>{{total}}</b></button>{{#if ../editing}}<input type="number" name="system.skills.{{key}}" value="{{level}}" min="0" aria-label="Уровень: {{name}}">{{/if}}</label>{{/each}}</div></details>
    </section>
    <section class="tab {{tabs.inventory.cssClass}}" data-group="creature" data-tab="inventory">{{> "systems/witcher-eliott-system/templates/inventory.hbs"}}</section>
    <section class="tab {{tabs.lore.cssClass}}" data-group="creature" data-tab="lore">
      <div class="witcher-npc-section-title"><h2>Описание и повадки</h2></div>
      {{#if editing}}<label>Категория<select name="system.creature.category">{{#each categories}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><div class="witcher-npc-facts"><label>Сложность<input name="system.creature.difficulty" value="{{system.creature.difficulty}}"></label><label>Награда<input type="number" name="system.creature.reward" value="{{system.creature.reward}}" min="0"></label><label>Естественная броня<input type="number" name="system.creature.naturalArmor" value="{{system.creature.naturalArmor}}" min="0"></label><label>Энергия<input type="number" name="system.vigor" value="{{system.vigor}}" min="0"></label></div>{{/if}}
      <div class="witcher-npc-facts">{{#each facts}}<label><span>{{label}}</span>{{#if ../editing}}<input name="system.creature.{{key}}" value="{{value}}">{{else}}<b>{{value}}</b>{{/if}}</label>{{/each}}</div>
      {{#if editing}}<label>Описание<textarea name="system.creature.description" rows="4">{{system.creature.description}}</textarea></label><label>Тактика<textarea name="system.creature.tactics" rows="4">{{system.creature.tactics}}</textarea></label>{{else}}<p>{{system.creature.description}}</p><blockquote>{{system.creature.tactics}}</blockquote>{{/if}}
      {{#each system.creature.lore}}<details class="witcher-npc-lore" open><summary>{{name}} <span>СЛ {{dc}}</span></summary>{{#if ../editing}}<input data-creature-list="lore" data-index="{{@index}}" data-key="name" value="{{name}}" aria-label="Название знания"><input type="number" data-creature-list="lore" data-index="{{@index}}" data-key="dc" value="{{dc}}" aria-label="Сложность знания"><input data-creature-list="lore" data-index="{{@index}}" data-key="skill" value="{{skill}}" aria-label="ID навыка знания"><textarea data-creature-list="lore" data-index="{{@index}}" data-key="text" rows="4">{{text}}</textarea><button type="button" data-action="removeCreatureRow" data-list="lore" data-index="{{@index}}">Удалить</button>{{else}}<p>{{text}}</p>{{/if}}</details>{{/each}}
      {{#if editing}}<button type="button" data-action="addCreatureRow" data-list="lore">Добавить знания</button>{{/if}}
      <div class="witcher-npc-section-title"><h2>Добыча</h2>{{#if isGM}}<button type="button" data-action="creatureLoot" {{disabled system.creature.lootGenerated}}>{{#if system.creature.lootGenerated}}Уже в инвентаре{{else}}Определить добычу{{/if}}</button>{{/if}}</div>
      <p class="witcher-combat-muted">Снаряжение уже находится в инвентаре. Кнопка один раз определяет добычу. Реагенты и мутагены собираются в разделе «Добыча» инвентаря.</p>
      <div class="witcher-npc-loot">{{#each system.creature.loot}}<div>{{#if ../editing}}<input data-creature-list="loot" data-index="{{@index}}" data-key="name" value="{{name}}" aria-label="Название добычи"><input data-creature-list="loot" data-index="{{@index}}" data-key="formula" value="{{formula}}" aria-label="Количество добычи"><label><input type="checkbox" data-creature-list="loot" data-index="{{@index}}" data-key="currency" {{checked currency}}>Кроны</label><button type="button" data-action="removeCreatureRow" data-list="loot" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></button>{{else}}<span>{{name}}</span><b>{{formula}}</b>{{/if}}</div>{{/each}}</div>
      {{#if editing}}<button type="button" data-action="addCreatureRow" data-list="loot">Добавить добычу</button><label>Источник<input name="system.creature.source" value="{{system.creature.source}}"></label><label>Заметки ведущего<textarea name="system.notes" rows="4">{{system.notes}}</textarea></label>{{else}}{{#if isGM}}<p>{{system.notes}}</p>{{/if}}<small>{{system.creature.source}}</small>{{/if}}
    </section>
  </div>
</div>
