<div class="witcher-npc-layout {{#if stats.dying}}is-dying{{/if}} {{#if stats.dead}}is-dead{{/if}}" data-category="{{system.creature.category}}">
  <header class="witcher-npc-header">
    <div class="witcher-npc-portrait-frame"><img class="witcher-npc-portrait" src="{{actor.img}}" data-action="creaturePortrait" alt="{{actor.name}}" data-tooltip="Изменить портрет"></div>
    <div class="witcher-npc-identity"><small>БЕСТИАРИЙ · THE WITCHER</small>{{#if editing}}<input type="text" name="name" value="{{actor.name}}" aria-label="Имя существа">{{else}}<h1>{{actor.name}}</h1>{{/if}}
      <div class="witcher-npc-traits">
        {{#if editing}}<label class="witcher-npc-category-select" data-tooltip="Проверка Атлетики при проходе по рассыпанным шарикам.">Опора<select name="system.creature.footing" aria-label="Опора существа">{{#each footingChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
        {{#if editing}}<label class="witcher-npc-category-select">Класс<select name="system.creature.category" aria-label="Класс чудовища">{{#each categories}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        {{else}}<span class="witcher-npc-category" tabindex="0" data-tooltip="{{creatureClass.description}}" aria-label="Класс чудовища: {{category}}">{{category}} <i class="fa-solid fa-circle-info" aria-hidden="true"></i></span>{{/if}}
        {{#if editing}}<label class="witcher-npc-category-select" data-tooltip="Модификатор размера: прибавляется к СЛ, если по существу стреляют, а оно не защищается.">Размер<select name="system.creature.sizeClass" aria-label="Размер существа">{{#each sizeClasses}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{else}}<span tabindex="0" data-tooltip="Модификатор размера {{sizeClass.modifier}} к СЛ, если по существу стреляют, а оно не защищается">Размер: {{sizeClass.name}}</span>{{/if}}
      </div>
    </div>
    <div class="witcher-npc-threat">
      <div><small>Опасность</small><b>{{#if system.creature.difficulty}}{{system.creature.difficulty}}{{else}}—{{/if}}</b></div>
      <div data-tooltip="Награда за победу по бестиарию"><small>Награда</small><b>{{#if system.creature.rewardNote}}<span class="witcher-npc-reward-note">{{system.creature.rewardNote}}</span>{{else}}<i class="fa-solid fa-coins" aria-hidden="true"></i> {{system.creature.reward}}{{/if}}</b></div>
    </div><button type="button" data-action="editCreature" class="witcher-npc-edit" aria-pressed="{{editing}}" aria-label="Редактировать существо" {{disabled (not editable)}}><i class="fa-solid fa-sliders"></i></button>
  </header>
  <nav class="witcher-npc-tabs tabs" aria-label="Разделы существа">{{#each tabs}}<button type="button" data-action="tab" data-group="creature" data-tab="{{id}}" class="{{cssClass}}"><i class="{{icon}}"></i> {{label}}{{#if (eq id "effects")}}{{#if @root.effects.length}} <b class="witcher-tab-count" data-tooltip="Активных эффектов">{{@root.effects.length}}</b>{{/if}}{{/if}}</button>{{/each}}</nav>
  <div class="witcher-npc-body">
    {{#if canRestoreItems}}<div class="witcher-npc-presets"><p>У этого профиля нет снаряжения и способностей из бестиария.</p><button type="button" data-action="restoreCreatureItems" {{disabled (not editable)}}>Восстановить предметы профиля</button></div>{{/if}}
    {{#if empty}}<div class="witcher-npc-presets"><strong>С чего начнём?</strong><p>Заполните существо вручную или возьмите готовый профиль.</p><button type="button" data-action="creaturePreset" data-preset="bestiaryBandit01" {{disabled (not editable)}}>Бандит</button><button type="button" data-action="creaturePreset" data-preset="bestiaryDrowner1" {{disabled (not editable)}}>Утопец</button></div>{{/if}}
    <section class="tab {{tabs.combat.cssClass}}" data-group="creature" data-tab="combat">
      <div class="witcher-npc-resources">
        <label class="npc-hp"><span><i class="witcher-npc-emblem fa-solid fa-heart" aria-hidden="true"></i>Пункты здоровья</span><div><input type="number" name="system.health.value" value="{{system.health.value}}" max="{{system.health.max}}" data-clamp-max="{{system.health.max}}" aria-label="ПЗ существа" {{disabled (not editable)}}><span>/ {{#if editing}}<input type="number" class="npc-max" name="system.creature.healthMax" value="{{system.creature.healthMax}}" min="0" data-tooltip="Максимум ПЗ. 0 — считать из ТЕЛ и ВОЛ (сейчас {{system.health.max}})." aria-label="Максимум ПЗ">{{else}}{{system.health.max}}{{/if}}</span></div><div class="witcher-meter is-health {{#if meters.health.low}}is-low{{/if}}" aria-hidden="true"><span style="width:{{meters.health.percent}}%"></span></div><small>Порог ранения {{stats.woundThreshold}}</small></label>
        <label class="npc-stamina"><span><i class="witcher-npc-emblem fa-solid fa-wind" aria-hidden="true"></i>Выносливость</span>{{#if creatureModes.infiniteStamina}}<div><strong aria-label="Бесконечная Выносливость">∞</strong></div><small>Конструкция: не устаёт</small>{{else}}<div><input type="number" name="system.stamina.value" value="{{system.stamina.value}}" min="0" max="{{system.stamina.max}}" data-clamp-max="{{system.stamina.max}}" aria-label="Выносливость существа" {{disabled (not editable)}}><span>/ {{#if editing}}<input type="number" class="npc-max" name="system.creature.staminaMax" value="{{system.creature.staminaMax}}" min="0" data-tooltip="Максимум ВЫН. 0 — считать из ТЕЛ и ВОЛ (сейчас {{system.stamina.max}})." aria-label="Максимум Выносливости">{{else}}{{system.stamina.max}}{{/if}}</span></div><div class="witcher-meter is-stamina {{#if meters.stamina.low}}is-low{{/if}}" aria-hidden="true"><span style="width:{{meters.stamina.percent}}%"></span></div><button type="button" data-action="creatureRecover" {{disabled (or (not editable) (not conditions.canRecover))}}>Отдых +{{stats.recovery}}</button>{{/if}}</label>
        {{#if verbalDuel}}<label class="npc-resolve"><span><i class="witcher-npc-emblem fa-solid fa-brain" aria-hidden="true"></i>Решительность</span><div><input type="number" name="system.resolve.value" value="{{system.resolve.value}}" min="0" max="{{system.resolve.max}}" aria-label="Решительность существа" {{disabled (not editable)}}><span>/ {{system.resolve.max}}</span></div></label>{{/if}}
        <div class="npc-stun"><span><i class="witcher-npc-emblem fa-solid fa-star-of-life" aria-hidden="true"></i>Устойчивость</span><strong>{{stats.stun}}</strong><button type="button" data-action="creatureStun" {{disabled (or (not editable) (not conditions.canStunSave))}} data-tooltip="1d10 строго меньше УСТ. Удача не тратится.">Испытание УСТ</button></div>
      </div>
      {{#if stats.dead}}<div class="witcher-npc-danger"><i class="fa-solid fa-skull"></i> Мёртв</div>{{/if}}
      {{#if regeneration.available}}<label class="witcher-npc-regeneration"><span><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i> Регенерация</span><select name="system.creature.regenerationMode" aria-label="Режим регенерации" {{disabled (not editable)}}>{{#each regeneration.options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><small>{{regeneration.label}}: {{regeneration.total}} ПЗ в начале хода. Подавляющие эффекты учитываются автоматически.</small></label>{{/if}}
      {{#if creatureModes.available}}<div class="witcher-creature-modes"><h3>Состояние существа</h3><div class="witcher-creature-mode-fields">{{#each creatureModes.fields}}<label>{{#if checkbox}}<input type="checkbox" data-creature-mode="{{key}}" {{checked checked}} {{disabled (not @root.editable)}}>{{label}}{{else}}<span>{{label}}</span>{{#if select}}<select data-creature-mode="{{key}}" {{disabled (not @root.editable)}}>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{else}}<input type="{{#if number}}number{{else}}text{{/if}}" data-creature-mode="{{key}}" value="{{value}}" {{#if number}}min="0" max="10000"{{/if}} {{disabled (not @root.editable)}}>{{/if}}{{/if}}</label>{{/each}}</div>{{#each creatureModes.notes}}<p>{{this}}</p>{{/each}}
        <div class="witcher-creature-specials">{{#if creatureModes.lycanthropy}}<button type="button" data-action="creatureLycanthropy" {{disabled (not editable)}}>Восход луны · 30%</button>{{/if}}{{#if creatureModes.detectMagic}}<button type="button" data-action="creatureDetect" data-magic="false" {{disabled (not editable)}}>Заметить · выбранный наблюдатель</button><button type="button" data-action="creatureDetect" data-magic="true" {{disabled (not editable)}}>Обнаружить магией</button>{{/if}}{{#if creatureModes.senseMagic}}<button type="button" data-action="creatureSenseMagic" {{disabled (not editable)}}>Почувствовать магию · 20 м</button>{{/if}}{{#if creatureModes.sirenIllusion}}<button type="button" data-action="creatureDispelIllusion" {{disabled (not editable)}}>Рассеять иллюзию · выбранный маг</button>{{/if}}{{#if creatureModes.falling}}<button type="button" data-action="creatureFall" {{disabled (not editable)}}>Следующие 30 м падения · осталось {{creatureModes.fallRemaining}} м</button>{{/if}}</div>
      </div>{{/if}}
      <div class="witcher-npc-statblock">
        <aside class="witcher-npc-aside">
          <div class="witcher-npc-stats">{{#each attributes}}<div><i class="witcher-npc-stat-icon {{icon}}" aria-hidden="true"></i><span data-tooltip="{{label}}">{{name}}</span>{{#if ../editing}}<input type="number" name="system.attributes.{{key}}" value="{{base}}" min="0" max="100" aria-label="{{label}}">{{else}}<button type="button" data-action="creatureAttribute" data-attribute="{{key}}" data-tooltip="Проверка {{label}}: 1d10 + {{value}}" {{disabled (not ../editable)}}>{{value}}</button>{{/if}}</div>{{/each}}</div>
          {{#if luck.visible}}<section class="witcher-npc-luck" aria-label="Удача">
            <div><strong>Удача {{luck.available}} / {{luck.maximum}}</strong>{{#if editing}}<input type="number" name="system.attributes.luck" value="{{system.attributes.luck}}" min="0" max="100" aria-label="Максимум Удачи">{{/if}}<button type="button" data-action="creatureLuck" data-reset="true" data-tooltip="Восстановить Удачу" aria-label="Восстановить Удачу" {{disabled (not editable)}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button></div>
            <div class="witcher-npc-luck-points">{{#each luck.points}}<button type="button" class="{{#if spent}}spent{{/if}} {{#if selected}}selected{{/if}}" data-action="creatureLuck" data-point="{{number}}" aria-pressed="{{selected}}" aria-label="Удача {{number}}" data-tooltip="Выбрать Удачу для следующего броска" {{disabled (or spent (not ../editable))}}>{{number}}</button>{{/each}}</div>
          </section>{{/if}}
          <button type="button" class="witcher-npc-initiative" data-action="creatureInitiative" {{disabled (not editable)}} data-tooltip="Бросить инициативу в боевом трекере"><i class="fa-solid fa-dice-d10"></i> Инициатива <b>+{{stats.initiative}}</b></button>
          <dl class="witcher-npc-movement"><div><dt>Бег</dt><dd>{{stats.run}} м</dd></div><div><dt>Прыжок</dt><dd>{{stats.leap}} м</dd></div><div><dt>Энергия</dt><dd>{{stats.vigor}}</dd></div></dl>
          {{#if editing}}<div class="witcher-npc-stat-overrides"><label>Базовый Бег<input type="number" name="system.creature.runBase" value="{{system.creature.runBase}}" min="0" data-tooltip="Бег из блока существа. 0 — СКОР × 3. Изменения СКОР пропорционально меняют Бег."></label><label>Базовый Отдых<input type="number" name="system.creature.recoveryBase" value="{{system.creature.recoveryBase}}" min="0" data-tooltip="Отдых из блока существа. 0 — считать из ТЕЛ и ВОЛ. Эффекты применяются к этой базе."></label></div>{{/if}}
          <h3 class="witcher-npc-aside-title"><i class="fa-solid fa-shield"></i> Броня</h3>
          <div class="witcher-npc-armor">{{#each inventory.zones}}<div><img src="{{img}}" alt=""><span>{{name}}</span>{{#each items}}<button type="button" data-action="viewSheetItem" data-item-id="{{id}}" data-tooltip="{{name}} · ПБ {{condition.value}} / {{condition.max}}{{#if broken}} · сломана{{/if}}" class="{{#if broken}}is-broken{{/if}}"><b>{{condition.value}}</b>{{#if broken}}<i class="fa-solid fa-heart-crack"></i>{{/if}}</button>{{else}}<b data-tooltip="Естественная броня">{{../naturalArmor}}</b>{{/each}}{{#if layered}}<b class="witcher-npc-armor-total" data-tooltip="Итог слоёв брони">= {{total}}</b>{{/if}}</div>{{/each}}</div>
          {{#if stats.naturalArmor}}<p class="witcher-npc-natural-armor">Естественная броня <b>+{{stats.naturalArmor}}</b> ко всем зонам, сверх надетой брони.</p>{{/if}}
          <h3 class="witcher-npc-aside-title"><i class="fa-solid fa-hand-sparkles"></i> Сопротивление</h3>
          <div class="witcher-npc-defense">{{#each defenses}}<button type="button" data-action="creatureDefense" data-skill="{{key}}" {{disabled (or (not ../editable) (not ../conditions.canDefend))}}><span>{{name}}</span><b>+{{total}}</b></button>{{/each}}</div>
          <div class="witcher-npc-resistances">{{#if editing}}<label data-tooltip="Сопротивление урону: урон этого типа после вычета ПБ делится вдвое. Коды Р/К/Д/С или слова; также «яд», «кровотечение».">Сопротивления<input type="text" name="system.creature.resistances" value="{{system.creature.resistances}}" placeholder="Р/К, огонь, яд…"></label>{{else}}{{#if resistanceList.length}}{{#each resistanceList}}<span class="witcher-npc-resistance" data-tooltip="Урон этого типа после брони уменьшается вдвое">{{this}}</span>{{/each}}{{/if}}{{/if}}</div>
          <h3 class="witcher-npc-aside-title"><i class="fa-solid fa-list-check"></i> Навыки <small>{{skills.length}}</small></h3>
          <div class="witcher-npc-skills">{{#each skills}}<label><button type="button" data-action="creatureSkill" data-skill="{{key}}" data-tooltip="{{calculation}}" {{disabled (not ../editable)}}><span>{{name}}</span><b>{{total}}</b></button>{{#if ../editing}}<input type="number" name="system.skills.{{key}}" value="{{level}}" min="0" aria-label="Уровень: {{name}}">{{/if}}</label>{{else}}<p class="witcher-combat-muted">Навыков нет. Включите редактирование, чтобы задать уровни.</p>{{/each}}</div>
          {{#if languages.length}}<h3 class="witcher-npc-aside-title"><i class="fa-solid fa-language" aria-hidden="true"></i> Языки</h3><div class="witcher-npc-skills">{{#each languages}}<label><button type="button" data-action="creatureSkill" data-skill="language" data-language-id="{{id}}" data-tooltip="{{calculation}}" {{disabled (not ../editable)}}><span>{{name}}</span><b>{{total}}</b></button>{{#if ../editing}}<input type="number" data-npc-language="{{index}}" value="{{level}}" min="0" aria-label="Уровень: {{name}}">{{/if}}</label>{{/each}}</div>{{/if}}
        </aside>
        <div class="witcher-npc-main">
          <div class="witcher-creature-specials">{{#each creatureSpecialActions}}<button type="button" data-action="creatureSpecial" data-creature-action="{{id}}" data-tooltip="{{hint}}" {{disabled (or disabled (not @root.editable))}}>{{name}}</button>{{/each}}{{#each creatureHagActions}}<button type="button" data-action="creatureHag" data-creature-action="{{id}}" {{disabled (or disabled (not @root.editable))}}>{{name}}</button>{{/each}}{{#if creatureWeb}}<button type="button" data-action="creatureWeb" {{disabled (not editable)}}>Ударить паутину</button>{{/if}}</div>
          <div class="witcher-npc-section-title"><h2>Особенности</h2><div><button type="button" data-action="browseEffects" {{disabled (not editable)}} data-tooltip="Добавить состояние"><i class="fa-solid fa-person-rays"></i></button><button type="button" data-action="createAbility" {{disabled (not editable)}} data-tooltip="Добавить способность"><i class="fa-solid fa-plus"></i></button></div></div>
          <div class="witcher-npc-abilities">{{#each abilities}}<details class="draggable" draggable="true" data-item-id="{{id}}"><summary><span>{{name}}</span>{{#if check}}<button type="button" class="witcher-npc-ability-roll" data-action="rollProfessionAbility" data-ability-id="{{check.id}}" data-tooltip="Бросок {{name}}: 1d10 + {{check.total}}" aria-label="Бросить {{name}}" {{disabled (or check.disabled (not ../editable))}}><i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{check.total}}</button>{{/if}}<button type="button" data-action="viewSheetItem" data-item-id="{{id}}" aria-label="Открыть способность: {{name}}" data-tooltip="Открыть"><i class="fa-solid fa-book-open"></i></button>{{#if ../editable}}<button type="button" class="witcher-npc-ability-remove" data-action="removeSheetItem" data-item-id="{{id}}" aria-label="Удалить способность: {{name}}" data-tooltip="Удалить способность"><i class="fa-solid fa-trash"></i></button>{{/if}}</summary><div>{{{description}}}</div>{{#if ../editing}}<button type="button" data-action="removeSheetItem" data-item-id="{{id}}">Удалить способность</button>{{/if}}</details>{{else}}<p>Перетащите способность из компендиума или создайте свою.</p>{{/each}}</div>
          {{> "systems/witcher-eliott-system/templates/combat-actions.hbs" compact=true}}
        </div>
      </div>
    </section>
    <section class="tab witcher-magic-page {{tabs.magic.cssClass}}" data-group="creature" data-tab="magic" aria-label="Магия существа">{{> "systems/witcher-eliott-system/templates/magic.hbs"}}</section>
    <section class="tab {{tabs.inventory.cssClass}}" data-group="creature" data-tab="inventory">{{> "systems/witcher-eliott-system/templates/inventory.hbs"}}</section>
    <section class="tab witcher-npc-effects-tab {{tabs.effects.cssClass}}" data-group="creature" data-tab="effects">{{> "systems/witcher-eliott-system/templates/effects-list.hbs"}}</section>
    <section class="tab {{tabs.lore.cssClass}}" data-group="creature" data-tab="lore">
      <section class="witcher-npc-class-description" aria-label="Класс чудовища">
        <small>Класс чудовища</small><h3>{{creatureClass.name}}</h3><p>{{creatureClass.description}}</p>
      </section>
      <div class="witcher-npc-section-title"><h2>Описание и повадки</h2></div>
      {{#if editing}}<div class="witcher-npc-facts"><label>Сложность<input name="system.creature.difficulty" value="{{system.creature.difficulty}}"></label><label>Награда<input type="number" name="system.creature.reward" value="{{system.creature.reward}}" min="0"></label><label>Награда (описание)<input name="system.creature.rewardNote" value="{{system.creature.rewardNote}}"></label><label>Естественная броня<input type="number" name="system.creature.naturalArmor" value="{{system.creature.naturalArmor}}" min="0"></label><label>Энергия<input type="number" name="system.vigor" value="{{system.vigor}}" min="0"></label></div>{{/if}}
      <div class="witcher-npc-facts">{{#each facts}}<label><span>{{label}}</span>{{#if ../editing}}<input name="system.creature.{{key}}" value="{{value}}">{{else}}<b>{{value}}</b>{{/if}}</label>{{/each}}</div>
      {{#if editing}}<label><input type="checkbox" name="system.creature.hasTailOrWings" {{checked system.creature.hasTailOrWings}}> Есть хвост или крылья</label><p class="witcher-combat-muted">Для чудовищ: при выпадении 10 удар приходится в хвост или крыло; если их нет — в левую конечность. Урон ×½ после брони.</p>{{else}}{{#if system.creature.hasTailOrWings}}<p>Есть хвост или крылья</p>{{/if}}{{/if}}
      {{#if editing}}<label>Описание<textarea name="system.creature.description" rows="4">{{system.creature.description}}</textarea></label><label>Тактика<textarea name="system.creature.tactics" rows="4">{{system.creature.tactics}}</textarea></label>{{else}}<p>{{system.creature.description}}</p><blockquote>{{system.creature.tactics}}</blockquote>{{/if}}
      {{#each system.creature.lore}}<details class="witcher-npc-lore" open><summary>{{name}} <span>СЛ {{dc}}</span></summary>{{#if ../editing}}<input data-creature-list="lore" data-index="{{@index}}" data-key="name" value="{{name}}" aria-label="Название знания"><input type="number" data-creature-list="lore" data-index="{{@index}}" data-key="dc" value="{{dc}}" aria-label="Сложность знания"><input data-creature-list="lore" data-index="{{@index}}" data-key="skill" value="{{skill}}" aria-label="ID навыка знания"><textarea data-creature-list="lore" data-index="{{@index}}" data-key="text" rows="4">{{text}}</textarea><button type="button" data-action="removeCreatureRow" data-list="lore" data-index="{{@index}}">Удалить</button>{{else}}<p>{{text}}</p>{{/if}}</details>{{/each}}
      {{#if editing}}<button type="button" data-action="addCreatureRow" data-list="lore">Добавить знания</button>{{/if}}
      {{#if editing}}<label>Источник<input name="system.creature.source" value="{{system.creature.source}}"></label><label>Заметки ведущего<textarea name="system.notes" rows="4">{{system.notes}}</textarea></label>{{else}}{{#if isGM}}<p>{{system.notes}}</p>{{/if}}<small>{{system.creature.source}}</small>{{/if}}
    </section>
  </div>
</div>
