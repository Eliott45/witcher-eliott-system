{{#*inline "centerLine"}}
      <div class="poker-center" aria-live="polite">
        {{#if result}}<div class="poker-result {{#if result.win}}is-win{{/if}} {{#if result.lose}}is-lose{{/if}}" role="status"><h2>{{result.title}}</h2>{{#if result.detail}}<p>{{result.detail}}</p>{{/if}}{{#if result.bank}}<p class="poker-bank-note"><i class="fa-solid fa-coins"></i> {{result.bank}}</p>{{/if}}</div>
        {{else}}<div class="poker-instruction"><p>{{#if waiting}}<i class="fa-solid fa-hourglass-half fa-fade"></i> {{/if}}{{instruction}}</p></div>{{/if}}
      </div>
{{/inline}}
{{#*inline "gatherControls"}}
        {{#if canJoin}}<div class="hoard-join"><label class="poker-inline-field"><span>Сесть за стол как</span><select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label>{{#if isFillet}}<label class="poker-inline-field tavern-bet-field"><span>Ставка, кр.</span><input name="bet" type="number" min="0" step="1" value="0"></label>{{/if}}<button type="button" data-action="join" {{disabled busy}}><i class="fa-solid fa-chair"></i> Сесть</button></div>{{/if}}
        {{#if canAddNpc}}<div class="hoard-join"><label class="poker-inline-field"><span>Посадить НПС</span><select name="npcUuid"><option value="">Выберите персонажа…</option>{{#each npcs}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if isFillet}}<label class="poker-inline-field tavern-bet-field"><span>Ставка, кр.</span><input name="bet" type="number" min="0" step="1" value="0"></label>{{/if}}<button type="button" data-action="addNpc" {{disabled busy}}><i class="fa-solid fa-user-plus"></i> Посадить</button></div>{{/if}}
        {{#if canStart}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="start" {{disabled busy}}><i class="fa-solid {{gameIcon}}"></i> Начать</button></div>{{/if}}
        {{#if canLeave}}<div class="poker-buttons"><button type="button" data-action="leave" {{disabled busy}}><i class="fa-solid fa-person-walking-arrow-right"></i> {{#if isDrink}}{{#if canDrink}}Сдаться{{else}}Встать из-за стола{{/if}}{{else}}Встать из-за стола{{/if}}</button></div>{{/if}}
        {{#if canCancel}}<div class="poker-buttons"><button type="button" data-action="cancel" {{disabled busy}}><i class="fa-solid fa-xmark"></i> Отменить стол</button></div>{{/if}}
        {{#if canRematch}}<div class="poker-buttons"><button type="button" class="poker-primary" data-action="rematch" {{disabled busy}}><i class="fa-solid fa-rotate-right"></i> Ещё раз</button><button type="button" data-action="lobby" {{disabled busy}}><i class="fa-solid fa-table-list"></i> Другие столы</button></div>{{/if}}
        {{#if busy}}<p class="poker-wait"><i class="fa-solid fa-spinner fa-spin"></i> Ход отправлен…</p>{{/if}}
{{/inline}}
{{#*inline "meter"}}{{#if bar}}<div class="tavern-meter is-{{kind}}" data-tooltip="{{label}}: {{bar.value}} / {{bar.max}}"><span style="width: {{bar.percent}}%"></span>{{#if mark}}<i style="left: {{mark}}%"></i>{{/if}}<small>{{label}} {{bar.value}}/{{bar.max}}</small></div>{{/if}}{{/inline}}
{{#*inline "seatHead"}}
  <header class="poker-seat-head">
    <img class="poker-portrait" src="{{seat.img}}" alt="">
    <div class="poker-seat-name"><small>{{seat.label}}{{#unless seat.online}} · не в сети{{/unless}}</small><h2>{{#if seat.winner}}<i class="fa-solid fa-crown"></i> {{/if}}{{seat.name}}</h2></div>
    {{#if seat.gems}}<span class="gwent-gems" aria-label="Выиграно раундов">{{#each seat.gems}}<i class="gwent-gem {{#if won}}is-won{{/if}}"></i>{{/each}}</span>{{/if}}
    {{#if seat.status}}<span class="poker-status">{{seat.status}}</span>{{/if}}
  </header>
{{/inline}}
{{#*inline "pokerSeat"}}
<section class="poker-seat {{#if seat.mine}}is-mine{{/if}} {{#if seat.winner}}is-winner{{/if}} {{#if seat.loser}}is-loser{{/if}}" aria-label="{{seat.label}}: {{seat.name}}">
  {{> seatHead seat=seat}}
  <div class="poker-dice">{{#each seat.dice}}<button type="button" class="poker-die {{#if selected}}is-selected{{/if}} {{#if hidden}}is-hidden{{/if}} {{#if scoring}}is-scoring{{/if}} {{#if swapped}}is-swapped{{/if}}" data-action="die" data-index="{{index}}" aria-label="Кость {{number}}: {{#if hidden}}скрыта{{else}}{{value}}{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{disabled (not selectable)}}>{{#if hidden}}<span class="poker-unknown">?</span>{{else}}<span class="poker-face" aria-hidden="true">{{#each dots}}<i class="poker-dot pos-{{position}}"></i>{{/each}}</span>{{/if}}{{#if selected}}<span class="poker-die-marker" aria-hidden="true"><i class="fa-solid {{#if ../palming}}fa-mask{{else}}fa-rotate{{/if}}"></i></span>{{/if}}</button>{{/each}}</div>
  <footer class="poker-hand rank-{{seat.rank}}"><strong>{{seat.combination}}</strong>{{#if seat.sum}}<small>сумма {{seat.sum}}</small>{{/if}}</footer>
</section>
{{/inline}}
{{#*inline "gwentSeat"}}
<section class="poker-seat gwent-seat {{#if seat.mine}}is-mine{{/if}} {{#if seat.winner}}is-winner{{/if}} {{#if seat.loser}}is-loser{{/if}}" aria-label="{{seat.label}}: {{seat.name}}">
  {{> seatHead seat=seat}}
  <div class="gwent-row">
    {{#if seat.play}}
      <article class="gwent-card tone-{{seat.play.tone}} {{#if seat.play.faded}}is-faded{{/if}}" data-tooltip="{{seat.play.text}}">
        <span class="gwent-card-mod">{{seat.play.mod}}</span><i class="fa-solid {{seat.play.icon}}" aria-hidden="true"></i><strong>{{seat.play.name}}</strong>
      </article>
      <div class="gwent-math {{#if seat.play.faded}}is-faded{{/if}}">
        {{#if seat.play.faded}}<small class="gwent-previous">прошлый раунд</small>{{/if}}
        <div class="gwent-parts">{{#each seat.play.parts}}<span><small>{{label}}</small><b>{{value}}</b></span>{{/each}}</div>
        {{#if seat.play.path}}<small class="gwent-path"><i class="fa-solid fa-route"></i> {{seat.play.path}}</small>{{/if}}
        {{#if seat.play.crit}}<small class="tavern-crit {{#if seat.play.fumble}}is-fumble{{/if}}"><i class="fa-solid {{#if seat.play.fumble}}fa-skull{{else}}fa-burst{{/if}}"></i> {{seat.play.crit}}</small>{{/if}}
      </div>
      <output class="gwent-total {{#if seat.play.faded}}is-faded{{/if}}">{{seat.play.total}}</output>
    {{else}}
      <article class="gwent-card is-back" aria-label="Карты ещё не разыграны"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></article>
      <div class="gwent-math"><small class="gwent-previous">{{seat.deckNote}}</small></div>
      <output class="gwent-total is-empty">–</output>
    {{/if}}
  </div>
  {{#if seat.history.length}}<footer class="gwent-history">{{#each seat.history}}<span class="is-{{result}}">Р{{round}} · {{total}}</span>{{/each}}<small>{{seat.deckNote}}</small></footer>{{/if}}
</section>
{{/inline}}
{{#*inline "deckPicker"}}
  <label class="poker-inline-field"><span>Колода</span><select name="deckId">{{#each deck.decks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
  {{#if deck.forgeries}}<label class="poker-toggle is-shady"><input type="checkbox" name="fakes" {{checked deck.fakes}}><span><i class="fa-solid fa-mask"></i> Подложить поддельные карты (+{{deck.forgeries}}). Видите только вы и мастер; соперник проверит Внимание СЛ {{deck.forgeryDc}}.</span></label>{{/if}}
{{/inline}}
<div class="poker-app game-{{game}} {{#if lobby}}is-lobby{{else}}phase-{{phase}}{{/if}}">
  <header class="poker-head">
    <div class="poker-title"><i class="fa-solid {{gameIcon}}" aria-hidden="true"></i><div><small>Развлечения в таверне</small><h1>{{gameName}}</h1></div></div>
    {{#if table}}<div class="poker-pills">{{#if spectator}}<span class="poker-pill is-watch"><i class="fa-solid fa-eye" aria-hidden="true"></i> Вы зритель</span>{{/if}}<span class="poker-pill">{{stage}}</span><span class="poker-pill is-gold"><i class="fa-solid fa-coins" aria-hidden="true"></i> {{#if isFillet}}Ставки {{pot}} кр.{{else if isHoard}}{{#if stake}}В корзине {{pot}} кр.{{else}}На монеты{{/if}}{{else}}{{#if stake}}Банк {{pot}} кр.{{else}}Без ставок{{/if}}{{/if}}</span></div>{{/if}}
  </header>
  {{#unless hasGM}}<p class="poker-notice" role="status"><i class="fa-solid fa-plug-circle-xmark"></i> Нужен подключённый мастер — он ведёт стол. Партия сохранена.</p>{{/unless}}
  {{#if notice}}<p class="poker-notice" role="alert"><i class="fa-solid fa-triangle-exclamation"></i> {{notice}}</p>{{/if}}
  {{#if lobby}}
    <div class="poker-lobby">
      <div class="tavern-games" role="group" aria-label="Игра">{{#each games}}<button type="button" class="tavern-game {{#if selected}}is-selected{{/if}}" data-action="game" data-game="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{name}}</button>{{/each}}</div>
      <div class="poker-fields">
        <label><span>Играть за</span><select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label>
        {{#if isGathering}}<p class="hoard-lobby-note"><i class="fa-solid fa-users"></i> {{#if isHoard}}От 2 до 4 игроков. Остальные подсаживаются из чата или списка столов{{else}}{{lobbyNote}}{{/if}}{{#if isGM}} Вы можете посадить НПС и играть за них.{{/if}}</p>
        {{else}}<label><span>Соперник</span><select name="opponentId"><option value="">Кого позвать за стол?</option>{{#each opponents}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if isGM}} · мастер{{/if}}</option>{{/each}}{{#if npcs.length}}<optgroup label="НПС — играете вы">{{#each npcs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</optgroup>{{/if}}</select></label>{{/if}}
      </div>
      {{#if isGwent}}<div class="gwent-deck-pick">{{> deckPicker deck=deck}}</div>{{/if}}
      {{#unless isFillet}}<div class="poker-stakes"><span>Ставка с каждого</span>
        <div class="poker-chips">{{#each stakes}}<button type="button" class="poker-chip {{#if selected}}is-selected{{/if}}" data-action="stake" data-value="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}<label class="poker-chip-input"><input name="stake" type="number" min="0" max="1000000" step="1" value="{{stake}}" aria-label="Своя ставка, кр."><span>кр.</span></label></div>
        <small>Деньги списываются, только когда соперник примет вызов. Победитель забирает банк, при ничьей ставки возвращаются.</small>
      </div>{{/unless}}
      <label class="poker-toggle"><input type="checkbox" name="open" {{checked openGame}}><span><i class="fa-solid fa-eye"></i> Пустить зрителей — партия видна всем за столом таверны</span></label>
      <button type="button" class="poker-primary poker-wide" data-action="challenge" {{disabled busy}}>{{#if isHoard}}<i class="fa-solid fa-staff-snake"></i> Поставить корзину со змеёй{{else if isGathering}}<i class="fa-solid {{gameIcon}}"></i> Открыть стол{{else}}<i class="fa-solid fa-hand-fist"></i> Бросить вызов{{/if}}</button>
      {{#if openTables}}<button type="button" class="poker-end-all" data-action="endAll" {{disabled busy}}><i class="fa-solid fa-hand"></i> Мастер: завершить все игры · {{openTables}}</button>{{/if}}
      {{#if recent}}<div class="poker-recent"><h3>Столы</h3>{{#each recent}}<button type="button" class="{{#if open}}is-open{{/if}}" data-action="openTable" data-table="{{id}}"><span><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{names}}</span><small>{{status}}{{#if stake}} · {{stake}} кр.{{/if}} {{#if watch}}<b><i class="fa-solid fa-eye"></i> смотреть</b>{{else}}<i class="fa-solid fa-chevron-right"></i>{{/if}}</small></button>{{/each}}</div>{{/if}}
    </div>
  {{else}}
    {{#if seatPicker.length}}<div class="seat-picker" role="group" aria-label="Вы ведёте"><span>Вы ведёте</span>{{#each seatPicker}}<button type="button" class="{{#if selected}}is-selected{{/if}} {{#if needs}}needs-move{{/if}}" data-action="seat" data-seat="{{index}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><img src="{{img}}" alt=""> {{name}}{{#if needs}} <i class="fa-solid fa-circle-exclamation" data-tooltip="Ждёт хода"></i>{{/if}}</button>{{/each}}</div>{{/if}}
    {{#if isHoard}}
    <div class="hoard-felt">
      <div class="hoard-ring">
        {{#each hoard.seats}}<article class="hoard-seat pos-{{index}} {{#if mine}}is-mine{{/if}} {{#if out}}is-out{{/if}} {{#if caught}}is-caught{{/if}}">
          <img class="poker-portrait" src="{{img}}" alt="">
          <div class="hoard-seat-name"><strong>{{name}}</strong><small>{{#if npc}}НПС · {{/if}}{{status}}{{#unless online}} · не в сети{{/unless}}</small></div>
          <div class="hoard-loot"><i class="fa-solid fa-coins" aria-hidden="true"></i> {{coins}}{{#if bites}} <span class="hoard-bites" data-tooltip="Укусов змеи"><i class="fa-solid fa-skull-crossbones"></i> {{bites}}</span>{{/if}}{{#if doped}} <span class="hoard-doped" data-tooltip="Дыхание суккуба: +5 к Ловкости рук. Видите только вы и мастер."><i class="fa-solid fa-mask"></i></span>{{/if}}</div>
          {{#if payout}}<div class="hoard-payout">Уносит {{payout}}</div>{{/if}}
          {{#if canKick}}<button type="button" class="hoard-kick" data-action="kick" data-seat="{{index}}" data-tooltip="Убрать из-за стола" aria-label="Убрать {{name}}" {{disabled ../busy}}><i class="fa-solid fa-xmark"></i></button>{{/if}}
        </article>{{/each}}
        {{#each hoard.empty}}<article class="hoard-seat pos-{{index}} is-empty"><i class="fa-solid fa-chair" aria-hidden="true"></i><small>Свободное место</small></article>{{/each}}
        <div class="hoard-basket {{#if hoard.snake}}is-alert{{/if}}">
          <div class="hoard-coins" aria-hidden="true">{{#each hoard.coins}}<i class="hoard-coin" style="--i:{{i}}"></i>{{/each}}</div>
          <div class="hoard-wicker"></div>
          <svg class="hoard-snake-svg" viewBox="0 0 120 110" aria-hidden="true"><path class="hoard-snake-body" d="M24 100 C 18 70, 92 78, 84 54 C 78 36, 40 46, 46 26 C 50 14, 64 12, 70 16"/><path class="hoard-snake-scales" d="M24 100 C 18 70, 92 78, 84 54 C 78 36, 40 46, 46 26 C 50 14, 64 12, 70 16"/><ellipse class="hoard-snake-head" cx="74" cy="17" rx="11" ry="7.5" transform="rotate(18 74 17)"/><circle class="hoard-snake-eye" cx="78" cy="14" r="1.8"/><path class="hoard-snake-tongue" d="M84 22 l7 4 m-7 -4 l4 7"/></svg>
          <div class="hoard-pot"><strong>{{hoard.potLabel}}</strong><small>в корзине · рывок {{hoard.grab}}</small></div>
          {{#if hoard.snake}}<div class="hoard-snake-roll {{#if hoard.snakeCrit}}is-crit{{/if}}" data-tooltip="Внимание змеи: 1d10 + {{hoard.awareness}}{{#if hoard.snakeCrit}} · {{hoard.snakeCrit}}{{/if}}"><small>Змея</small><b>{{hoard.snake}}</b></div>{{/if}}
        </div>
      </div>
      <div class="poker-center" aria-live="polite">
        {{#if result}}<div class="poker-result" role="status"><h2>{{result.title}}</h2>{{#if result.detail}}<p>{{result.detail}}</p>{{/if}}{{#if result.bank}}<p class="poker-bank-note"><i class="fa-solid fa-coins"></i> {{result.bank}}</p>{{/if}}</div>
        {{else}}<div class="poker-instruction"><p>{{#if waiting}}<i class="fa-solid fa-hourglass-half fa-fade"></i> {{/if}}{{instruction}}</p></div>{{/if}}
      </div>
      {{#if hoard.log.length}}<ol class="hoard-log">{{#each hoard.log}}<li class="is-{{tone}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{text}}</li>{{/each}}</ol>{{/if}}
      <div class="poker-actions">
        {{#if canJoin}}<div class="hoard-join"><label class="poker-inline-field"><span>Сесть за стол как</span><select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label><button type="button" data-action="join" {{disabled busy}}><i class="fa-solid fa-chair"></i> Сесть</button></div>{{/if}}
        {{#if canAddNpc}}<div class="hoard-join"><label class="poker-inline-field"><span>Посадить НПС</span><select name="npcUuid"><option value="">Выберите персонажа…</option>{{#each npcs}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button type="button" data-action="addNpc" {{disabled busy}}><i class="fa-solid fa-user-plus"></i> Посадить</button></div>{{/if}}
        {{#if canStart}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="start" {{disabled busy}}><i class="fa-solid fa-staff-snake"></i> Встряхнуть корзину и начать</button></div>{{/if}}
        {{#if canReach}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big is-shady" data-action="reach" {{disabled busy}}><i class="fa-solid fa-hand-holding-dollar"></i> Сунуть руку в корзину</button></div>{{/if}}
        {{#if canLeave}}<div class="poker-buttons"><button type="button" data-action="leave" {{disabled busy}}>{{#if canReach}}<i class="fa-solid fa-person-walking-arrow-right"></i> Забрать добычу и отойти{{else}}<i class="fa-solid fa-person-walking-arrow-right"></i> Встать из-за стола{{/if}}</button></div>{{/if}}
        {{#if canCancel}}<div class="poker-buttons"><button type="button" data-action="cancel" {{disabled busy}}><i class="fa-solid fa-xmark"></i> Убрать корзину</button></div>{{/if}}
        {{#if canRematch}}<div class="poker-buttons"><button type="button" class="poker-primary" data-action="rematch" {{disabled busy}}><i class="fa-solid fa-rotate-right"></i> Ещё раз</button><button type="button" data-action="lobby" {{disabled busy}}><i class="fa-solid fa-table-list"></i> Другие столы</button></div>{{/if}}
        {{#if busy}}<p class="poker-wait"><i class="fa-solid fa-spinner fa-spin"></i> Змея следит…</p>{{/if}}
      </div>
    </div>
    {{else if isArm}}
    <div class="poker-felt arm-felt">
      {{#with arm.top as |seat|}}<section class="arm-seat {{#if seat.mine}}is-mine{{/if}}"><img class="poker-portrait" src="{{seat.img}}" alt=""><div class="hoard-seat-name"><strong>{{seat.name}}</strong><small>{{seat.label}}{{#unless seat.online}} · не в сети{{/unless}}{{#if seat.status}} · {{seat.status}}{{/if}}</small>{{> meter bar=seat.stamina kind="stamina" label="Выносливость" mark=seat.thresholdPercent}}</div><output class="arm-total {{#if seat.faded}}is-faded{{/if}}">{{#if seat.total}}{{seat.total}}{{else}}–{{/if}}</output>{{#if seat.crit}}<small class="tavern-crit">{{seat.crit}}</small>{{/if}}{{#if seat.trick}}<small class="arm-trick">{{seat.trick}}</small>{{/if}}</section>{{/with}}
      <div class="arm-arena" aria-label="Перевес">
        <div class="arm-track"><span class="arm-mark lean-{{arm.lean}}"><i class="fa-solid fa-hand-fist"></i></span><b class="arm-pin is-top"></b><b class="arm-pin is-bottom"></b></div>
        {{#if arm.history.length}}<div class="gwent-history">{{#each arm.history}}<span class="is-{{won}}">Р{{round}} · {{totals}}</span>{{/each}}</div>{{/if}}
      </div>
      {{#with arm.bottom as |seat|}}<section class="arm-seat {{#if seat.mine}}is-mine{{/if}}"><img class="poker-portrait" src="{{seat.img}}" alt=""><div class="hoard-seat-name"><strong>{{seat.name}}</strong><small>{{seat.label}}{{#unless seat.online}} · не в сети{{/unless}}{{#if seat.status}} · {{seat.status}}{{/if}}</small>{{> meter bar=seat.stamina kind="stamina" label="Выносливость" mark=seat.thresholdPercent}}</div><output class="arm-total {{#if seat.faded}}is-faded{{/if}}">{{#if seat.total}}{{seat.total}}{{else}}–{{/if}}</output>{{#if seat.crit}}<small class="tavern-crit">{{seat.crit}}</small>{{/if}}{{#if seat.trick}}<small class="arm-trick">{{seat.trick}}</small>{{/if}}</section>{{/with}}
      {{> centerLine}}
      <div class="poker-actions">
        {{#if canAccept}}<label class="poker-inline-field"><span>Играть за</span><select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label><div class="poker-buttons"><button type="button" class="poker-primary" data-action="accept" {{disabled busy}}><i class="fa-solid fa-handshake"></i> Принять{{#if stake}} · {{stake}} кр.{{/if}}</button><button type="button" data-action="decline" {{disabled busy}}>Отказаться</button></div>{{/if}}
        {{#if canPress}}<label class="poker-toggle is-shady"><input type="checkbox" name="trick"><span><i class="fa-solid fa-mask"></i> Незаметно упереться свободной рукой: +5 к Силе, если соперник не заметит (Ловкость рук против Внимания)</span></label>
          <div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="press" {{disabled busy}}><i class="fa-solid fa-hand-fist"></i> Давить!</button></div>{{/if}}
        {{> gatherControls}}
      </div>
    </div>
    {{else if isDrink}}
    <div class="poker-felt drink-felt">
      <div class="drink-dc"><i class="fa-solid fa-beer-mug-empty"></i> {{#if drink.round}}Порция {{drink.round}} · СЛ {{drink.dc}}{{else}}Первая порция · СЛ {{drink.dc}}{{/if}}</div>
      <div class="drink-seats">{{#each drink.seats}}<article class="drink-seat {{#if mine}}is-mine{{/if}} {{#if out}}is-out{{/if}} {{#if tipsy}}is-tipsy{{/if}} {{#if winner}}is-winner{{/if}}">
        <img class="poker-portrait" src="{{img}}" alt=""><div class="hoard-seat-name"><strong>{{name}}</strong><small>{{#if npc}}НПС · {{/if}}{{status}}{{#if acted}} · выпил{{/if}}{{#unless online}} · не в сети{{/unless}}</small></div>
        <div class="drink-mugs" aria-label="Выпито порций">{{#each drinks}}<i class="fa-solid fa-beer-mug-empty"></i>{{/each}}{{#if more}}<b>+{{more}}</b>{{/if}}</div>
        {{#if oil}}<small class="drink-oil" data-tooltip="Видите только вы и мастер"><i class="fa-solid fa-droplet"></i> масло: ещё {{oil}} порц.{{#if pending}} · отложено {{pending}}{{/if}}</small>{{/if}}
        {{#if canSurprise}}<button type="button" class="drink-surprise" data-action="surprise" data-seat="{{index}}" {{disabled ../busy}} data-tooltip="Внезапная проверка Стойкости СЛ 10"><i class="fa-solid fa-bell"></i></button>{{/if}}
        {{#if kick}}<button type="button" class="hoard-kick" data-action="kick" data-seat="{{index}}" aria-label="Убрать {{name}}" {{disabled ../busy}}><i class="fa-solid fa-xmark"></i></button>{{/if}}
      </article>{{/each}}</div>
      {{> centerLine}}
      {{#if drink.log.length}}<ol class="hoard-log">{{#each drink.log}}<li class="is-{{tone}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{text}}</li>{{/each}}</ol>{{/if}}
      <div class="poker-actions">
        {{#if canDrink}}{{#if canOil}}<label class="poker-toggle is-shady"><input type="checkbox" name="oil"><span><i class="fa-solid fa-droplet"></i> Сперва тайком выпить масло: следующие {{drink.oilPortions}} порции без проверок, потом всё разом</span></label>{{/if}}
          <div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="drink" {{disabled busy}}><i class="fa-solid fa-beer-mug-empty"></i> Осушить кружку</button></div>{{/if}}
        {{> gatherControls}}
      </div>
    </div>
    {{else if isFillet}}
    <div class="poker-felt fillet-felt">
      <section class="fillet-performer {{#if fillet.cut}}is-cut{{/if}}">
        <img class="poker-portrait" src="{{fillet.performer.img}}" alt=""><div class="hoard-seat-name"><strong>{{fillet.performer.name}}</strong><small>Исполнитель · Азартные игры: {{fillet.odds}}{{#if fillet.oddsCrit}} ({{fillet.oddsCrit}}){{/if}}</small></div>
        <svg class="fillet-hand" viewBox="0 0 220 120" aria-hidden="true"><path class="fillet-palm" d="M40 112 C 30 80, 40 66, 62 62 L 160 62 C 182 64, 190 84, 182 112 Z"/><g class="fillet-fingers"><rect x="38" y="20" width="18" height="52" rx="9"/><rect x="72" y="6" width="18" height="62" rx="9"/><rect x="106" y="2" width="18" height="66" rx="9"/><rect x="140" y="10" width="18" height="58" rx="9"/><rect x="176" y="40" width="18" height="40" rx="9" transform="rotate(28 185 60)"/></g><g class="fillet-knife"><path d="M98 0 L 104 52 L 98 58 L 92 52 Z"/><rect x="94" y="-26" width="8" height="26" rx="2"/></g></svg>
        <div class="fillet-stages">{{#each fillet.stages}}<span class="{{#if current}}is-current{{/if}} {{#if done}}is-done{{/if}}"><b>{{number}}</b><small>СЛ {{dc}}</small></span>{{/each}}</div>
      </section>
      <div class="fillet-bank"><span><i class="fa-solid fa-coins"></i> Ставки: <b>{{fillet.total}}</b> / {{fillet.limit}} кр.</span>{{#if fillet.room}}<small>ещё можно {{fillet.room}} кр.</small>{{/if}}</div>
      {{#if fillet.bettors.length}}<ul class="fillet-bettors">{{#each fillet.bettors}}<li class="{{#if mine}}is-mine{{/if}}"><img src="{{img}}" alt=""><span>{{name}}{{#if npc}} · НПС{{/if}}</span><b>{{bet}} кр.</b>{{#if kick}}<button type="button" class="hoard-kick" data-action="kick" data-seat="{{index}}" aria-label="Убрать {{name}}" {{disabled ../busy}}><i class="fa-solid fa-xmark"></i></button>{{/if}}</li>{{/each}}</ul>{{/if}}
      {{> centerLine}}
      {{#if fillet.log.length}}<ol class="hoard-log">{{#each fillet.log}}<li class="is-{{tone}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{text}}</li>{{/each}}</ol>{{/if}}
      <div class="poker-actions">
        {{#if canBet}}<div class="hoard-join"><label class="poker-inline-field tavern-bet-field"><span>Ваша ставка, кр.</span><input name="bet" type="number" min="{{fillet.myBet}}" step="1" value="{{fillet.myBet}}"></label><button type="button" data-action="bet" {{disabled busy}}><i class="fa-solid fa-coins"></i> Поставить</button></div>{{/if}}
        {{#if canStab}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big is-shady" data-action="stab" {{disabled busy}}><i class="fa-solid fa-utensils"></i> Стучать ножом · СЛ {{fillet.dc}}</button></div>{{/if}}
        {{#if canDecide}}<div class="poker-buttons"><button type="button" class="poker-primary" data-action="stop" {{disabled busy}}><i class="fa-solid fa-coins"></i> Забрать ставки</button>{{#if fillet.canSpeed}}<button type="button" class="is-shady" data-action="speed" {{disabled busy}}><i class="fa-solid fa-gauge-high"></i> Ускориться · СЛ {{fillet.nextDC}}</button>{{/if}}</div>{{/if}}
        {{#if canResume}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="resume" {{disabled busy}}><i class="fa-solid fa-play"></i> Продолжить</button></div>{{/if}}
        {{> gatherControls}}
      </div>
    </div>
    {{else if isBrawl}}
    <div class="poker-felt brawl-felt">
      <div class="brawl-ring">{{#each brawl.seats}}<article class="brawl-fighter {{#if mine}}is-mine{{/if}} {{#unless active}}is-out{{/unless}} {{#if winner}}is-winner{{/if}}">
        <img class="poker-portrait" src="{{img}}" alt=""><div class="hoard-seat-name"><strong>{{name}}</strong><small>{{#if npc}}НПС · {{/if}}{{#if out}}{{out}}{{else}}В строю{{/if}}{{#unless online}} · не в сети{{/unless}}</small></div>
        {{> meter bar=health kind="health" label="ПЗ" mark=0}}{{> meter bar=stamina kind="stamina" label="Выносливость" mark=0}}
        {{#if warnings.length}}<small class="brawl-warning" data-tooltip="Кулачный бой — без брони и оружия"><i class="fa-solid fa-triangle-exclamation"></i> {{#each warnings}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</small>{{/if}}
        {{#if hidden}}<small class="brawl-hidden"><i class="fa-solid fa-mask"></i> {{hidden}}</small>{{/if}}
        {{#if canAward}}<button type="button" class="brawl-award" data-action="award" data-seat="{{index}}" {{disabled ../busy}} data-tooltip="Мастер: присудить победу"><i class="fa-solid fa-crown"></i></button>{{/if}}
        {{#if kick}}<button type="button" class="hoard-kick" data-action="kick" data-seat="{{index}}" aria-label="Убрать {{name}}" {{disabled ../busy}}><i class="fa-solid fa-xmark"></i></button>{{/if}}
      </article>{{/each}}</div>
      {{> centerLine}}
      {{#if brawl.log.length}}<ol class="hoard-log">{{#each brawl.log}}<li class="is-{{tone}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{text}}</li>{{/each}}</ol>{{/if}}
      <div class="poker-actions">
        {{#if canYield}}<div class="poker-buttons"><button type="button" data-action="yield" {{disabled busy}}><i class="fa-solid fa-flag"></i> Сдаться</button></div>{{/if}}
        {{> gatherControls}}
      </div>
    </div>
    {{else}}
    <div class="poker-felt {{#if isGwent}}is-gwent{{/if}}">
      {{#if isGwent}}{{> gwentSeat seat=top}}{{else}}{{> pokerSeat seat=top palming=canPalm}}{{/if}}
      <div class="poker-center" aria-live="polite">
        {{#if result}}
          <div class="poker-result {{#if result.win}}is-win{{/if}} {{#if result.lose}}is-lose{{/if}}" role="status"><h2>{{result.title}}</h2>{{#if result.detail}}<p>{{result.detail}}</p>{{/if}}{{#if result.bank}}<p class="poker-bank-note"><i class="fa-solid fa-coins"></i> {{result.bank}}</p>{{/if}}</div>
        {{else}}
          <div class="poker-instruction">{{#if roundLine}}<strong class="gwent-round-line">{{roundLine}}</strong>{{/if}}<p>{{#if waiting}}<i class="fa-solid fa-hourglass-half fa-fade"></i> {{/if}}{{instruction}}</p></div>
        {{/if}}
      </div>
      {{#if isGwent}}{{> gwentSeat seat=bottom}}{{else}}{{> pokerSeat seat=bottom palming=canPalm}}{{/if}}
      <div class="poker-actions">
        {{#if canAccept}}<label class="poker-inline-field"><span>Играть за</span><select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label>
          {{#if isGwent}}{{> deckPicker deck=deck}}{{/if}}
          <div class="poker-buttons"><button type="button" class="poker-primary" data-action="accept" {{disabled busy}}><i class="fa-solid fa-handshake"></i> Принять{{#if stake}} · {{stake}} кр.{{/if}}</button><button type="button" data-action="decline" {{disabled busy}}>Отказаться</button></div>{{/if}}
        {{#if canCancel}}<div class="poker-buttons"><button type="button" data-action="cancel" {{disabled busy}}><i class="fa-solid fa-xmark"></i> Отозвать вызов</button></div>{{/if}}
        {{#if canRoll}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="roll" {{disabled busy}}><i class="fa-solid fa-dice"></i> Бросить кости</button></div>{{/if}}
        {{#if canDraw}}<div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="reroll" {{disabled busy}}>{{#if selectedCount}}<i class="fa-solid fa-rotate"></i> Перебросить отмеченные · {{selectedCount}}{{else}}<i class="fa-solid fa-hand"></i> Оставить все и вскрыть{{/if}}</button></div>{{/if}}
        {{#if canPalm}}<div class="poker-palm"><span><i class="fa-solid fa-mask"></i> Новое значение</span><div class="poker-palm-faces">{{#each palmValues}}<button type="button" class="poker-die is-mini {{#if selected}}is-selected{{/if}}" data-action="palmValue" data-value="{{value}}" aria-label="Значение {{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{disabled ../busy}}><span class="poker-face" aria-hidden="true">{{#each dots}}<i class="poker-dot pos-{{position}}"></i>{{/each}}</span></button>{{/each}}</div>{{#if palmPreview}}<em>станет: {{palmPreview}}</em>{{/if}}</div>
          <div class="poker-buttons"><button type="button" class="poker-primary is-shady" data-action="palm" {{disabled (or busy (not palmReady))}}><i class="fa-solid fa-mask"></i> Подменить и вскрыть</button><button type="button" data-action="fair" {{disabled busy}}><i class="fa-solid fa-scale-balanced"></i> Играть честно</button></div>{{/if}}
        {{#if canPlay}}<div class="gwent-skills" role="group" aria-label="Навык">{{#each skills}}<button type="button" class="gwent-skill {{#if selected}}is-selected{{/if}}" data-action="skill" data-skill="{{key}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{disabled ../busy}}>{{label}} <b>{{value}}</b></button>{{/each}}</div>
          <div class="poker-buttons"><button type="button" class="poker-primary poker-big" data-action="play" {{disabled busy}}><i class="fa-solid fa-layer-group"></i> Разыграть раунд {{round}}</button></div>{{/if}}
        {{#if canRematch}}<div class="poker-buttons"><button type="button" class="poker-primary" data-action="rematch" {{disabled busy}}><i class="fa-solid fa-rotate-right"></i> Реванш</button><button type="button" data-action="lobby" {{disabled busy}}><i class="fa-solid fa-table-list"></i> Другие столы</button></div>{{/if}}
        {{#if busy}}<p class="poker-wait"><i class="fa-solid fa-spinner fa-spin"></i> {{#if isGwent}}Карты на столе…{{else}}Кости в пути…{{/if}}</p>{{/if}}
      </div>
    </div>
    {{/if}}
    <footer class="poker-management">
      {{#unless canRematch}}<button type="button" data-action="lobby" {{disabled busy}}><i class="fa-solid fa-arrow-left"></i> Столы</button>{{/unless}}
      {{#if canConcede}}<button type="button" data-action="concede" {{disabled busy}}><i class="fa-solid fa-flag"></i> Сдаться</button>{{/if}}
      {{#if canRecover}}<button type="button" data-action="recover" {{disabled busy}}>Повторить расчёт банка</button>{{/if}}
      {{#if canAbort}}<button type="button" data-action="abort" {{disabled busy}}><i class="fa-solid fa-hand"></i> Мастер: завершить досрочно</button>{{/if}}
    </footer>
  {{/if}}
  {{#if isHoard}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Правила драконьего клада</summary>
    <p>В центре стола корзина с ядовитой змеёй, вокруг — по 10 монет от каждого (или по ставке в кронах). В начале каждого раунда змея проверяет Внимание: 1d10 + 12.</p>
    <p>Каждый участник тянется к корзине: Ловкость рук должна быть выше результата змеи — тогда он забирает 5 монет (половину ставки). Промах — Уклонение против укуса (атака 1d10 + 10); укушенный получает отравление.</p>
    <p>Игра идёт, пока монеты не кончатся или игроки не отойдут с добычей. Оставшиеся монеты делятся поровну, каждый уносит своё.</p>
    <p><i class="fa-solid fa-mask"></i> Под «Дыханием суккуба» (на коже или выпитым) змея хуже замечает руку: +5 к Ловкости рук. Остальные один раз проверяют Внимание СЛ 16 — заметят, и обманщик выбывает, а его монеты возвращаются в корзину.</p>
  </details>
  {{else if isArm}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Правила борьбы на руках</summary>
    <p>Участники делают встречные проверки Силы. Чтобы победить, нужно выиграть два раунда подряд: первый успех — начинаете одолевать, второй — победа. Ничья в раунде сбрасывает перевес.</p>
    <p>Каждый раунд оба тратят по 5 Выносливости. Если у соперника Выносливость опускается до порога ранения или ниже — вы побеждаете.</p>
    <p><i class="fa-solid fa-mask"></i> Приём: незаметно опереться свободной рукой. Ловкость рук против Внимания соперника; не заметит — +5 к этой проверке Силы, заметит — схватка проиграна. «Дьявольский мускус» даёт +3 к Силе на 5 минут, потом — тошнота.</p>
  </details>
  {{else if isDrink}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Правила соревнования по выпивке</summary>
    <p>Все пьют вместе и проходят проверку Стойкости со СЛ 10; с каждой новой порцией СЛ растёт на 2. Первый провал — опьянение, второй — тошнота и выход из соревнования. Побеждает последний, кто держится; выбывшие в одном раунде делят победу.</p>
    <p>В любой момент мастер может назначить проверку Стойкости СЛ 10: провал — тошнота и проигрыш.</p>
    <p><i class="fa-solid fa-droplet"></i> Приём: выпить единицу масла (материал «Масло» при себе). Следующие три порции проверки не проходятся, потом участник проходит все пропущенные разом.</p>
  </details>
  {{else if isFillet}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Правила филе из пяти пальцев</summary>
    <p>Исполнитель бьёт ножом между пальцами: Владение лёгкими клинками против СЛ 12. Его проверка Азартных игр — максимальная сумма, которую зрители поставят против него.</p>
    <p>После удачного удара можно забрать ставки или ускориться: СЛ +3, лимит ставок удваивается, зрители могут поднять ставки. Ускоряться можно дважды.</p>
    <p>Промах — каждый поставивший получает свою ставку вдвое (исполнитель покрывает все ставки).</p>
  </details>
  {{else if isBrawl}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Правила кулачного боя</summary>
    <p>От 2 до 4 участников, обнажённые по пояс и без доспехов. Кастеты и тайное оружие запрещены, но все боевые приёмы и трюки разрешены. Побеждает тот, кто останется в сознании и не сдастся.</p>
    <p>Бой идёт по обычным правилам в трекере боя. Стол сам замечает, кто потерял сознание, и выплачивает банк победителю; мастер может присудить победу вручную.</p>
    <p><i class="fa-solid fa-mask"></i> «Скрытый вес» в кулаке: 1d6 к урону без оружия. В начале боя каждый соперник проверяет Внимание СЛ 18 — заметит, и боец дисквалифицирован. «Дьявольский мускус» — +3 к Силе на 5 минут.</p>
  </details>
  {{else if isGwent}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Карты и правила гвинта</summary>
    <ol class="gwent-table">{{#each gwentRules}}<li><b>{{faces}}</b><i class="fa-solid {{icon}}" aria-hidden="true"></i><strong>{{name}}</strong><span>{{mod}}</span><small>{{text}}</small></li>{{/each}}</ol>
    <p>В начале каждого раунда оба тянут карту (d10 по таблице) и добавляют модификатор к проверке Азартных игр или Тактики. Выше результат — раунд ваш. Партия — до двух выигранных раундов, максимум три раунда; возможны ничьи. Редкая колода даёт +1…+3 — её назначает мастер в листе колоды.</p>
    <p><i class="fa-solid fa-mask"></i> Поддельная карта: набор для письма, 3 часа и проверка Подделки (кнопка на колоде). Каждая даёт +1, не больше +3. Соперник один раз проверяет Внимание против худшего результата Подделки: заметит — шулер проигрывает.</p>
  </details>
  {{else}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Комбинации и правила</summary>
    <ol>{{#each combinations}}<li><strong>{{name}}</strong><span aria-hidden="true">{{example}}</span></li>{{/each}}</ol>
    <p>Оба бросают по пять костей, затем один раз перебрасывают любые из них или оставляют все. После переброса кости сразу вскрываются. При одинаковой комбинации решает её достоинство, затем остальные кости; без комбинации — сумма. Полное равенство — ничья.</p>
    <p><i class="fa-solid fa-mask"></i> С шулерскими костями при себе вы увидите все кости перед вскрытием и сможете подменить одну свою. Соперник проверяет Внимание СЛ {{dc}}: заметит — шулер проигрывает.</p>
  </details>
  {{/if}}
</div>
