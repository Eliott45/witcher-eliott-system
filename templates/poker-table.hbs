<section class="poker-scroll">
  <header class="poker-banner"><span class="poker-eyebrow">Развлечения в таверне</span><h1><i class="fa-solid fa-dice"></i> Покер на костях</h1><p>Пять костей. Один переброс. Один победитель.</p></header>
  {{#unless hasGM}}<p class="poker-notice" role="status">Для продолжения нужен подключённый мастер. Партия сохранена.</p>{{/unless}}
  {{#if notice}}<p class="poker-notice" role="alert">{{notice}}</p>{{/if}}
  {{#if lobby}}
    <div class="poker-lobby">
      <h2>Занять место за столом</h2>
      <div class="poker-fields"><label>Играть за<select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label>
      <label>Вызвать соперника<select name="opponentId"><option value="">Выберите участника…</option>{{#each opponents}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if isGM}} · Мастер{{/if}}</option>{{/each}}</select></label></div>
      <label class="poker-wager">Ставка с каждого, кр.<input name="stake" type="number" min="0" max="1000000" step="1" value="{{stake}}"><small>0 — без ставок. Деньги списываются после принятия вызова.</small></label>
      <button type="button" class="poker-primary" data-action="challenge" {{disabled busy}}><i class="fa-solid fa-handshake"></i> Бросить вызов</button>
      <p class="poker-muted">За столом нужна доска для покера и десять костей. Можно использовать общую доску в таверне.</p>
      {{#if recent}}<div class="poker-recent"><h3>Ваши столы</h3>{{#each recent}}<button type="button" data-action="openTable" data-table="{{id}}"><span>{{names}}</span><small>{{status}} · {{stake}} кр. <i class="fa-solid fa-arrow-right"></i></small></button>{{/each}}</div>{{/if}}
    </div>
  {{else}}
    <div class="poker-toolbar"><button type="button" data-action="lobby" {{disabled busy}}><i class="fa-solid fa-arrow-left"></i> Столы</button><strong>{{stage}}</strong><span class="poker-bank"><i class="fa-solid fa-coins"></i> {{#if stake}}Банк {{pot}} кр.{{else}}Без ставок{{/if}}</span></div>
    <div class="poker-felt" aria-label="Игровой стол">
      {{#each seats}}<section class="poker-seat {{#if mine}}is-mine{{/if}} {{#if winner}}is-winner{{/if}}" aria-label="Кости: {{name}}">
        <header><div><span class="poker-seat-label">{{#if mine}}Ваши кости{{else}}Соперник{{/if}}</span><h2>{{#if winner}}<i class="fa-solid fa-crown"></i> {{/if}}{{name}}</h2></div><small>{{#unless online}}Не в сети · {{/unless}}{{status}}</small></header>
        <div class="poker-dice">{{#each dice}}<button type="button" class="poker-die {{#if selected}}is-selected{{/if}} {{#if hidden}}is-hidden{{/if}}" data-action="die" data-index="{{index}}" aria-label="Кость {{number}}: {{#if hidden}}скрыта{{else}}{{value}}{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{disabled (not selectable)}}>{{#if hidden}}<span class="poker-unknown">?</span>{{else}}<span class="poker-face" aria-hidden="true">{{#each dots}}<i class="poker-dot pos-{{position}}"></i>{{/each}}</span>{{/if}}{{#if selected}}<span class="poker-die-marker"><i class="fa-solid fa-rotate"></i></span>{{/if}}</button>{{/each}}</div>
        <footer><strong>{{combination}}</strong>{{#if sum}}<span>Сумма {{sum}}</span>{{/if}}</footer>
      </section>{{/each}}
      {{#if result}}<div class="poker-result" role="status"><i class="fa-solid fa-medal"></i><h2>{{result}}</h2>{{#if resultNote}}<p>{{resultNote}}</p>{{/if}}</div>{{/if}}
    </div>
    <div class="poker-play-controls" aria-live="polite"><p>{{instruction}}</p>
      {{#if canAccept}}<label>Играть за<select name="actorUuid"><option value="">От своего имени · без кошелька</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}} кр.</option>{{/each}}</select></label><div class="poker-buttons"><button type="button" class="poker-primary" data-action="accept" {{disabled busy}}>Принять{{#if stake}} · {{stake}} кр.{{/if}}</button><button type="button" data-action="decline" {{disabled busy}}>Отказаться</button></div>{{/if}}
      {{#if canCancel}}<button type="button" data-action="cancel" {{disabled busy}}>Отозвать приглашение</button>{{/if}}
      {{#if canRoll}}<button type="button" class="poker-primary" data-action="roll" {{disabled busy}}><i class="fa-solid fa-dice"></i> Бросить 5 костей</button>{{/if}}
      {{#if canDraw}}<div class="poker-buttons"><button type="button" class="poker-primary" data-action="reroll" {{disabled busy}}><i class="fa-solid fa-rotate"></i> Перебросить выбранные · {{selectedCount}}</button><button type="button" data-action="keep" {{disabled busy}}>Оставить все</button></div>{{/if}}
      {{#if canCheat}}<details class="poker-cheat"><summary><i class="fa-solid fa-mask"></i> Шулерские кости · только вам</summary><p>Можно изменить одну кость перед вскрытием. Распознать шулерские кости: Внимание СЛ 16. Проверку наблюдения проводит мастер.</p><label><input name="cheat" type="checkbox" {{checked cheatEnabled}}> Подменить результат одной кости</label><div class="poker-fields"><label>Кость слева<select name="cheatIndex">{{#each cheatIndices}}<option value="{{index}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Новое значение<select name="cheatValue">{{#each cheatValues}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label></div></details>{{/if}}
      {{#if canFinish}}<button type="button" class="poker-primary" data-action="finish" {{disabled busy}}><i class="fa-solid fa-check"></i> Готов к вскрытию</button>{{/if}}
      {{#if canRematch}}<button type="button" class="poker-primary" data-action="rematch" {{disabled busy}}><i class="fa-solid fa-rotate-right"></i> Предложить реванш</button>{{/if}}
      {{#if busy}}<p class="poker-wait"><i class="fa-solid fa-spinner fa-spin"></i> Ход отправлен…</p>{{/if}}
    </div>
    <footer class="poker-management">{{#if canConcede}}<button type="button" data-action="concede" {{disabled busy}}>Сдаться</button>{{/if}}{{#if canRecover}}<button type="button" data-action="recover" {{disabled busy}}>Повторить расчёт банка</button>{{/if}}{{#if canAbort}}<button type="button" data-action="abort" {{disabled busy}}>Мастер: отменить с возвратом</button>{{/if}}<small>Закрытие окна не прерывает партию.</small></footer>
  {{/if}}
  <details class="poker-rules" {{#if rulesOpen}}open{{/if}}><summary><i class="fa-solid fa-book-open"></i> Комбинации и правила</summary><p>Каждый бросает 5d6, затем один раз перебрасывает любые кости или оставляет всё. Итоговые кости открываются, когда оба участника готовы.</p><ol>{{#each combinations}}<li><strong>{{name}}</strong><span>{{example}}</span></li>{{/each}}</ol><p>Сильнейшая комбинация вверху. При одинаковой комбинации сравнивается её достоинство, затем оставшиеся кости по убыванию. Без комбинации — сумма. Полное равенство — ничья и возврат ставок.</p><small>Сравнение одинаковых комбинаций — принятое за этим столом уточнение. Источник: «Развлечения в таверне».</small></details>
</section>
