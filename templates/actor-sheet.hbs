<div class="witcher-character-layout{{#if stats.death.dead}} is-dead{{else if stats.death.active}} is-dying{{else if stats.wounded}} is-wounded{{/if}}">
  <aside class="witcher-character-sidebar">
    <section class="witcher-resources" aria-label="{{localize 'WITCHER.Sheet.Resources'}}">
    <fieldset class="witcher-resource health">
      <legend><i class="witcher-resource-emblem fa-solid fa-heart" aria-hidden="true"></i><span data-tooltip="{{stats.healthTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Sheet.Health"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></legend>
      <div class="witcher-resource-values">
        <label for="{{rootId}}-health-value"><span class="witcher-resource-caption">{{localize "WITCHER.Sheet.Current"}}</span>
          <input id="{{rootId}}-health-value" type="number" name="system.health.value"
                 value="{{system.health.value}}" step="1" {{disabled (not editable)}}>
        </label>
        <span aria-hidden="true">/</span>
        <label for="{{rootId}}-health-max"><span class="witcher-resource-caption">{{localize "WITCHER.Sheet.Maximum"}}</span>
          {{#if stats.physicalReady}}
          <output id="{{rootId}}-health-max">{{system.health.max}}</output>
          {{else}}
          <input id="{{rootId}}-health-max" type="number" name="system.health.max"
                 value="{{system.health.max}}" min="0" step="1" {{disabled (not editable)}}>
          {{/if}}
        </label>
      </div>
    <div class="witcher-meter is-health {{#if meters.health.low}}is-low{{/if}}" aria-hidden="true"><span style="width:{{meters.health.percent}}%"></span></div>
    </fieldset>
    <div class="witcher-stat-row witcher-resource-detail">
      <span data-tooltip="{{stats.woundThreshold.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="witcher-stat-icon {{stats.woundThreshold.icon}}" aria-hidden="true"></i>{{localize stats.woundThreshold.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
      <strong>{{stats.woundThreshold.value}}</strong>
    </div>
    {{#if stats.wounded}}<p class="witcher-wound-notice" role="status">{{localize stats.woundNotice}}</p>{{/if}}
    {{#if temporaryHealth}}<div class="witcher-stat-row witcher-resource-detail" data-tooltip="«Полнолуние»: временные ПЗ поглощают урон первыми и пропадают с концом эликсира."><span>Временные ПЗ</span><strong>+{{temporaryHealth}}</strong></div>{{/if}}
    {{#if stats.death.dead}}
    <section class="witcher-death-state dead" role="status">
      <h3><i class="fa-solid fa-skull" aria-hidden="true"></i> {{localize "WITCHER.Effects.Dead"}}</h3>
      <p>{{localize "WITCHER.Death.DeadNotice"}}</p>
    </section>
    {{else if stats.death.active}}
    <section class="witcher-death-state" aria-label="{{localize 'WITCHER.Effects.Dying'}}">
      <h3><i class="fa-solid fa-skull" aria-hidden="true"></i> {{localize "WITCHER.Effects.Dying"}}</h3>
      <p>{{localize "WITCHER.Death.Penalties"}}</p>
      <div class="witcher-stat-row">
        <label for="{{rootId}}-death-penalty">{{localize "WITCHER.Death.Penalty"}}</label>
        <input id="{{rootId}}-death-penalty" type="number" name="system.death.penalty" min="0" step="1"
               value="{{stats.death.penalty}}" {{disabled (not editable)}}>
      </div>
      <div class="witcher-stat-row">
        <span data-tooltip="{{stats.death.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Death.Target"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
        <strong>&lt; {{stats.death.target}}</strong>
      </div>
      <button type="button" class="witcher-stun-roll" data-action="rollDeath"
              {{#if stats.stunUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
        <i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Death.Roll"}}
      </button>
    </section>
    {{/if}}
    <div class="witcher-derived witcher-stun-block" aria-label="{{localize 'WITCHER.Statistics.Physical'}}">
      <div class="witcher-stat-row">
        <span data-tooltip="{{stats.stunTooltip}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="witcher-stat-icon fa-solid fa-star-of-life" aria-hidden="true"></i>{{localize "WITCHER.Statistics.Stun"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span><strong>{{stats.stunValue}}</strong>
      </div>
      <button type="button" class="witcher-stun-roll" data-action="rollStun"
              {{#if conditions.stunUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
        <i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Statistics.RollStun"}}
      </button>
    </div>
    <fieldset class="witcher-resource stamina">
      <legend><i class="witcher-resource-emblem fa-solid fa-wind" aria-hidden="true"></i><span data-tooltip="{{stats.staminaTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Sheet.Stamina"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></legend>
      <div class="witcher-resource-values">
        <label for="{{rootId}}-stamina-value"><span class="witcher-resource-caption">{{localize "WITCHER.Sheet.Current"}}</span>
          <input id="{{rootId}}-stamina-value" type="number" name="system.stamina.value"
                 value="{{system.stamina.value}}" min="0" step="1" {{disabled (not editable)}}>
        </label>
        <span aria-hidden="true">/</span>
        <label for="{{rootId}}-stamina-max"><span class="witcher-resource-caption">{{localize "WITCHER.Sheet.Maximum"}}</span>
          {{#if stats.physicalReady}}
          <output id="{{rootId}}-stamina-max">{{system.stamina.max}}</output>
          {{else}}
          <input id="{{rootId}}-stamina-max" type="number" name="system.stamina.max"
                 value="{{system.stamina.max}}" min="0" step="1" {{disabled (not editable)}}>
          {{/if}}
        </label>
      </div>
    <div class="witcher-meter is-stamina {{#if meters.stamina.low}}is-low{{/if}}" aria-hidden="true"><span style="width:{{meters.stamina.percent}}%"></span></div>
    </fieldset>
    <div class="witcher-stat-row witcher-resource-detail">
      <span data-tooltip="{{stats.recovery.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="witcher-stat-icon {{stats.recovery.icon}}" aria-hidden="true"></i>{{localize stats.recovery.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
      <strong>{{stats.recovery.value}}</strong>
    </div>
    <button type="button" class="witcher-stun-roll" data-action="recoverStamina" title="{{conditions.recoveryHint}}"
            {{#if conditions.recoveryUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
      <i class="fa-solid fa-bed" aria-hidden="true"></i> {{localize "WITCHER.Conditions.Recover"}}
    </button>
    {{#if conditions.exhausted}}
    <p class="witcher-exhaustion-notice" role="status">{{conditions.staminaHint}}</p>
    {{/if}}
    {{#if conditions.unconscious}}
    <p class="witcher-exhaustion-notice">{{localize "WITCHER.Effects.Unconscious"}}</p>
    {{/if}}
    <fieldset class="witcher-resource resolve {{#if verbalDuel}}is-dueling{{/if}}">
      <legend><i class="witcher-resource-emblem fa-solid fa-brain" aria-hidden="true"></i><span data-tooltip="Решительность: заменяет ПЗ в словесной дуэли. (ВОЛЯ + ИНТ) / 2 × 5. На 0 персонаж проигрывает дуэль и делает то, чего хотел противник." data-tooltip-direction="RIGHT" tabindex="0">Решительность <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></legend>
      <div class="witcher-resource-values">
        <label for="{{rootId}}-resolve-value"><span class="witcher-resource-caption">{{localize "WITCHER.Sheet.Current"}}</span>
          <input id="{{rootId}}-resolve-value" type="number" name="system.resolve.value"
                 value="{{system.resolve.value}}" min="0" step="1" {{disabled (not editable)}}>
        </label>
        <span aria-hidden="true">/</span>
        <label for="{{rootId}}-resolve-max"><span class="witcher-resource-caption">{{localize "WITCHER.Sheet.Maximum"}}</span>
          <output id="{{rootId}}-resolve-max">{{system.resolve.max}}</output>
        </label>
      </div>
    <div class="witcher-meter is-resolve {{#if meters.resolve.low}}is-low{{/if}}" aria-hidden="true"><span style="width:{{meters.resolve.percent}}%"></span></div>
    </fieldset>
  </section>
    {{#if inventory.toxicity.visible}}
    <section class="witcher-sidebar-toxicity {{#if inventory.toxicity.overloaded}}is-overloaded{{/if}} {{#if inventory.toxicity.value}}is-toxic{{/if}}" aria-label="{{localize 'WITCHER.Toxicity.Title'}}">
      <div class="witcher-toxicity-heading"><span data-tooltip="{{localize 'WITCHER.Toxicity.Hint'}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="fa-solid fa-flask" aria-hidden="true"></i> {{localize "WITCHER.Toxicity.Title"}}</span><output>{{inventory.toxicity.value}}<small>%</small></output></div>
      <progress value="{{inventory.toxicity.value}}" max="{{inventory.toxicity.limit}}" aria-label="{{localize 'WITCHER.Toxicity.Title'}}"></progress>
      <div class="witcher-toxicity-caption"><span>{{localize "WITCHER.Toxicity.Limit"}} {{inventory.toxicity.limit}}%</span>{{#if inventory.toxicity.poisoned}}<strong>{{localize "WITCHER.Toxicity.Poisoned"}}</strong>{{/if}}</div>
      {{#if toxicitySave}}
      <button type="button" class="witcher-stun-roll witcher-toxicity-save" data-action="rollEffectSave" data-effect-id="{{toxicitySave.id}}" data-tooltip="{{localize 'WITCHER.Toxicity.SaveHint'}}" {{disabled (not toxicitySave.available)}}><i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Toxicity.Save"}}</button>
      <small class="witcher-toxicity-save-hint">{{localize "WITCHER.Toxicity.SaveHint"}}</small>
      {{/if}}
    </section>
    {{/if}}
    <section class="witcher-derived" aria-label="{{localize 'WITCHER.Statistics.Combat'}}">
      {{#each stats.movementRows as |stat|}}
      <div class="witcher-stat-row">
        <span data-tooltip="{{stat.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="witcher-stat-icon {{stat.icon}}" aria-hidden="true"></i>{{localize stat.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span><strong>{{stat.value}} {{stat.unit}}</strong>
      </div>
      {{/each}}
      <div class="witcher-stat-entry">
        <span data-tooltip="{{stats.carryTooltip}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="witcher-stat-icon fa-solid fa-weight-hanging" aria-hidden="true"></i>{{localize "WITCHER.Statistics.Carry"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
        <div class="witcher-stat-entry-value">
          <output id="{{rootId}}-weight">{{stats.carriedWeight}} / {{stats.carryMax}} {{localize "WITCHER.Statistics.Kilograms"}}</output>
        </div>
      </div>
      <div class="witcher-stat-entry">
        <label for="{{rootId}}-vigor"><span data-tooltip="{{stats.vigorTooltip}}" data-tooltip-direction="RIGHT" tabindex="0"><i class="witcher-stat-icon fa-solid fa-wand-sparkles" aria-hidden="true"></i>{{localize "WITCHER.Statistics.Vigor"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></label>
        <div class="witcher-vigor-total"><span>{{localize "WITCHER.Statistics.Total"}}</span><output data-tooltip="{{stats.vigorTooltip}}" tabindex="0">{{stats.vigorTotal}}</output></div>
        <label class="witcher-vigor-base" for="{{rootId}}-vigor"><span>{{localize "WITCHER.Statistics.Base"}}</span><input id="{{rootId}}-vigor" name="system.vigor" type="number" min="0" step="1" value="{{system.vigor}}" {{disabled (not editable)}}></label>
      </div>
    </section>
  </aside>
  <div class="witcher-character-main">
    <header class="witcher-character-name">
      <div class="witcher-portrait-frame">
          <button type="button" class="witcher-portrait-button" data-action="showPortraitArtwork"
                  aria-label="{{localize 'WITCHER.Sheet.ViewPortrait'}}" title="{{localize 'WITCHER.Sheet.ViewPortrait'}}">
            <img class="witcher-portrait" src="{{actor.img}}" alt="{{actor.name}}">
          </button>
          {{#if editable}}
          <button type="button" class="witcher-edit-portrait" data-action="editPortrait"
                  aria-label="{{localize 'WITCHER.Sheet.Portrait'}}" title="{{localize 'WITCHER.Sheet.Portrait'}}">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
          </button>
          {{/if}}
        </div>
      <label class="witcher-sr-only" for="{{rootId}}-name">{{localize "WITCHER.Sheet.Name"}}</label>
      <input id="{{rootId}}-name" name="name" type="text" value="{{actor.name}}" required {{disabled (not editable)}}>
      <p class="witcher-character-subtitle">{{#if selectedRace}}<span>{{localize selectedRace.label}}</span>{{/if}}{{#if profession}}<span>{{profession.name}}</span>{{/if}}{{#if system.details.age}}<span>{{system.details.age}} лет</span>{{/if}}</p>
      <div class="witcher-character-counters">
      <div class="witcher-header-counter witcher-experience">
        <div class="witcher-experience-heading"><span>{{localize "WITCHER.Advancement.Experience"}}</span><button type="button" data-action="toggleExperience" role="switch" aria-checked="{{editingExperience}}" aria-label="{{localize 'WITCHER.Advancement.Adjust'}}" data-tooltip="{{localize 'WITCHER.Advancement.Adjust'}}" {{disabled (not editable)}}><i class="fa-regular {{#if editingExperience}}fa-square-check{{else}}fa-square{{/if}}" aria-hidden="true"></i></button></div>
        {{#if editingExperience}}<input type="number" min="0" step="1" required value="{{system.experience}}" data-sheet-experience data-header-counter="experience" data-expected="{{system.experience}}" aria-label="{{localize 'WITCHER.Advancement.Balance'}}">{{else}}<strong>{{system.experience}}</strong>{{/if}}
        <button type="button" class="witcher-experience-open" data-action="openAdvancement" aria-label="{{localize 'WITCHER.Advancement.Title'}}" {{disabled (not editable)}}><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i> {{localize "WITCHER.Advancement.Open"}}</button>
      </div>
      <div class="witcher-header-counter witcher-reputation">
        <div class="witcher-experience-heading"><span>{{localize "WITCHER.Reputation.Title"}}</span><button type="button" data-action="toggleReputation" role="switch" aria-checked="{{editingReputation}}" aria-label="{{localize 'WITCHER.Reputation.Edit'}}" data-tooltip="{{localize 'WITCHER.Reputation.Edit'}}" {{disabled (not editable)}}><i class="fa-regular {{#if editingReputation}}fa-square-check{{else}}fa-square{{/if}}" aria-hidden="true"></i></button></div>
        {{#if editingReputation}}<input type="number" min="0" max="10" step="1" required value="{{system.reputation.value}}" data-header-counter="reputation" data-expected="{{system.reputation.value}}" aria-label="{{localize 'WITCHER.Reputation.Base'}}" data-tooltip="{{reputation.tooltip}}">{{else}}<strong data-tooltip="{{reputation.tooltip}}" tabindex="0">{{reputation.total}}</strong>{{/if}}
        <button type="button" class="witcher-experience-open" data-action="rollReputation" aria-label="{{localize 'WITCHER.Reputation.Roll'}}" data-tooltip="{{reputation.formula}}" {{disabled reputation.rollUnavailable}} {{disabled (not editable)}}><i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Reputation.RollShort"}}</button>
      </div>
      <div class="witcher-reputation-bonus {{#if reputation.bonusActive}}active{{/if}}">
        <button type="button" data-action="toggleReputationBonus" role="switch" aria-checked="{{reputation.bonusEnabled}}" aria-label="{{localize 'WITCHER.Reputation.Bonus'}}" data-tooltip="{{reputation.bonusHint}}" {{disabled (not editable)}}><i class="fa-solid {{#if reputation.bonusEnabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i><span>{{localize "WITCHER.Reputation.Bonus"}} <b>+3</b></span></button>
        <button type="button" data-action="configureReputationBonus" aria-label="{{localize 'WITCHER.Reputation.Configure'}}" data-tooltip="{{localize 'WITCHER.Reputation.Configure'}}" {{disabled (not editable)}}><i class="fa-solid fa-sliders" aria-hidden="true"></i></button>
      </div>
      </div>
      <div class="witcher-luck">
        <div class="witcher-luck-heading">
          <label for="{{rootId}}-luck" data-tooltip="{{stats.luck.tooltip}}" tabindex="0">{{localize "WITCHER.Attributes.luck.Label"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></label>
          {{#if editingAttributes}}
          <input id="{{rootId}}-luck" name="system.attributes.luck" type="number" min="0" max="100" step="1"
                 value="{{system.attributes.luck}}" placeholder="—" aria-label="{{localize 'WITCHER.Statistics.Base'}}" data-tooltip="{{stats.luck.valueTooltip}}">
          {{/if}}
          <output {{#unless editingAttributes}}id="{{rootId}}-luck"{{/unless}} class="witcher-luck-remaining" data-tooltip="{{stats.luck.valueTooltip}}" tabindex="0">{{stats.luck.available}} / {{stats.luck.maximum}}</output>
          {{#if stats.luck.pending}}<span class="witcher-luck-selected">+{{stats.luck.pending}} {{localize "WITCHER.Luck.NextRoll"}}</span>{{/if}}
          <button type="button" class="witcher-attribute-roll" data-action="rollAttribute" data-attribute="luck"
                  title="{{stats.luck.rollHint}}" aria-label="{{stats.luck.rollHint}}" {{#if stats.luck.rollUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
            <i class="fa-solid fa-dice-d10" aria-hidden="true"></i>
          </button>
          <button type="button" class="witcher-reset-luck" data-action="resetLuck" title="{{localize 'WITCHER.Luck.Reset'}}"
                  aria-label="{{localize 'WITCHER.Luck.Reset'}}" {{disabled (not editable)}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
        </div>
        <div class="witcher-luck-points" role="group" aria-label="{{localize 'WITCHER.Luck.Points'}}">
          {{#each stats.luck.points as |point|}}
          <button type="button" class="witcher-luck-point {{#if point.spent}}spent{{/if}} {{#if point.selected}}selected{{/if}}" data-action="toggleLuck" data-point="{{point.number}}"
                  aria-pressed="{{point.selected}}" aria-label="{{localize 'WITCHER.Luck.Point'}} {{point.number}}" {{#if point.spent}}disabled{{else}}{{disabled (not ../editable)}}{{/if}}>{{point.number}}</button>
          {{/each}}
        </div>
      </div>
    </header>
    {{#if needsCreation}}<div class="witcher-creation-banner"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i><p>Чистый лист. Создайте героя по правилам: раса, родина и семья, жизненный путь, профессия, параметры, навыки и снаряжение — с бросками или на выбор.</p><button type="button" data-action="openCharacterCreation">Создать персонажа</button></div>{{/if}}
    <nav class="witcher-character-tabs tabs" aria-label="{{localize 'WITCHER.Sheet.Title'}}">
      {{#each visibleTabs as |tab|}}
      <button type="button" class="{{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
              aria-pressed="{{tab.active}}" aria-controls="{{../rootId}}-{{tab.id}}" title="{{localize tab.label}}" aria-label="{{localize tab.label}}">
        <i class="{{tab.icon}}" aria-hidden="true"></i>
        <span class="witcher-tab-label">{{localize tab.label}}</span>
      </button>
      {{/each}}
      <button type="button" class="witcher-manage-tabs" data-action="configureTabs"
              title="{{localize 'WITCHER.Sheet.ManageTabs'}}" aria-label="{{localize 'WITCHER.Sheet.ManageTabs'}}">
        <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
      </button>
    </nav>
    <section id="{{rootId}}-main" class="witcher-character-content tab {{tabs.main.cssClass}}" data-group="character" data-tab="main"
             aria-label="{{localize 'WITCHER.Sheet.Main'}}">
      <section class="witcher-identity-panel" aria-labelledby="{{rootId}}-identity-title">
      <h2 id="{{rootId}}-identity-title" class="witcher-panel-title">{{localize "WITCHER.Sheet.BasicInfo"}}</h2>
      <div class="witcher-character-hero">
        <div class="witcher-character-references">
          <div class="witcher-reference-field">
            <span class="witcher-field-label">{{localize "WITCHER.Sheet.Race"}}</span>
            <div class="witcher-reference-value">
              {{#if selectedRace}}
              <button type="button" class="witcher-select-reference" data-action="viewRace"
                      title="{{localize 'WITCHER.Sheet.ViewRace'}}">
                <span>{{localize selectedRace.label}}</span>
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
              </button>
              {{else}}
              <span class="witcher-select-reference">{{localize "WITCHER.Sheet.RaceUnset"}}</span>
              {{/if}}
              <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="race"
                      aria-label="{{localize 'WITCHER.Sheet.ChooseRace'}}" title="{{localize 'WITCHER.Sheet.ChooseRace'}}" {{disabled (not editable)}}>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div class="witcher-reference-field">
            <span class="witcher-field-label">{{localize "WITCHER.Sheet.Origin"}}</span>
            <div class="witcher-reference-value">
              {{#if selectedOrigin}}
              <button type="button" class="witcher-select-reference" data-action="viewOrigin"
                      title="{{localize 'WITCHER.Sheet.ViewOrigin'}}">
                <span>{{localize selectedOrigin.label}}</span>
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
              </button>
              {{else}}
              <span class="witcher-select-reference">{{localize "WITCHER.Sheet.OriginUnset"}}</span>
              {{/if}}
              <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="origin"
                      aria-label="{{localize 'WITCHER.Sheet.ChooseOrigin'}}" title="{{localize 'WITCHER.Sheet.ChooseOrigin'}}" {{disabled (not editable)}}>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          {{#if showFamilyStatus}}
          <div class="witcher-reference-field">
            <span class="witcher-field-label">{{localize "WITCHER.Sheet.FamilyStatus"}}</span>
            <div class="witcher-reference-value">
              {{#if selectedFamilyStatus}}
              <button type="button" class="witcher-select-reference" data-action="viewFamilyStatus"
                      title="{{localize 'WITCHER.Sheet.ViewFamilyStatus'}}">
                <span>{{localize selectedFamilyStatus.label}}</span>
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
              </button>
              {{else}}
              <span class="witcher-select-reference">{{localize "WITCHER.Sheet.FamilyStatusUnset"}}</span>
              {{/if}}
              <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="familyStatus"
                      aria-label="{{localize 'WITCHER.Sheet.ChooseFamilyStatus'}}" title="{{localize 'WITCHER.Sheet.ChooseFamilyStatus'}}" {{disabled (not editable)}}>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          {{/if}}
<div class="witcher-profession-choice"><label class="witcher-field-label">{{localize "WITCHER.Professions.Title"}}</label><div class="witcher-reference-value">
{{#if profession}}<button type="button" class="witcher-select-reference" data-action="viewSheetItem" data-uuid="{{profession.uuid}}">{{profession.name}} <i class="fa-solid fa-ellipsis-vertical"></i></button>{{else}}<span class="witcher-select-reference">{{localize "WITCHER.Professions.Unset"}}</span>{{/if}}
<button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="profession" title="{{localize 'WITCHER.Professions.Choose'}}" aria-label="{{localize 'WITCHER.Professions.Choose'}}" {{disabled (not editable)}}><i class="fa-solid fa-magnifying-glass"></i></button></div></div>
        </div>
      </div>
      <div class="witcher-demographics">
        <label for="{{rootId}}-gender">{{localize "WITCHER.Sheet.Gender"}}
          <input id="{{rootId}}-gender" name="system.details.gender" type="text" value="{{system.details.gender}}" {{disabled (not editable)}}>
        </label>
        <label for="{{rootId}}-age">{{localize "WITCHER.Sheet.Age"}}
          <input id="{{rootId}}-age" name="system.details.age" type="number" min="0" step="1"
                 value="{{system.details.age}}" placeholder="—" {{disabled (not editable)}}>
        </label>
      </div>
      </section>
      <section class="witcher-parameters" aria-label="{{localize 'WITCHER.Statistics.Primary'}}">
      <div class="witcher-parameters-heading">
        <h2 class="witcher-panel-title">{{localize "WITCHER.Statistics.Primary"}}</h2>
        <button type="button" class="witcher-edit-attributes" data-action="toggleAttributes" role="switch" aria-checked="{{editingAttributes}}"
                title="{{localize 'WITCHER.Statistics.Edit'}}" {{disabled (not editable)}}>
          <i class="fa-solid {{#if editingAttributes}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>
          {{localize "WITCHER.Statistics.Edit"}}
        </button>
      </div>
      {{#if editingAttributes}}<p class="witcher-base-hint">{{localize "WITCHER.Statistics.EditHint"}}</p>{{/if}}
      <div class="witcher-attribute-grid">
        {{#each stats.attributes as |attribute|}}
        <div class="witcher-attribute {{#if attribute.reduced}}reduced{{/if}}" data-attribute="{{attribute.key}}">
          <i class="witcher-attribute-emblem {{attribute.icon}}" aria-hidden="true"></i>
          <span class="witcher-attribute-short">{{localize attribute.short}}</span>
          <label class="witcher-attribute-name" for="{{../rootId}}-attribute-{{attribute.key}}" data-tooltip="{{attribute.tooltip}}" tabindex="0">
            {{localize attribute.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
          </label>
          <div class="witcher-attribute-value">
          {{#if ../editingAttributes}}
          <input id="{{../rootId}}-attribute-{{attribute.key}}" name="system.attributes.{{attribute.key}}" type="number"
                 min="0" max="100" step="1" value="{{attribute.value}}" placeholder="—" data-tooltip="{{attribute.valueTooltip}}">
          {{else}}
          <output id="{{../rootId}}-attribute-{{attribute.key}}" data-tooltip="{{attribute.valueTooltip}}" tabindex="0">{{attribute.effective}}</output>
          {{/if}}
          <button type="button" class="witcher-attribute-roll" data-action="rollAttribute" data-attribute="{{attribute.key}}"
                  title="{{attribute.rollHint}}" aria-label="{{attribute.rollHint}}" {{#if attribute.rollUnavailable}}disabled{{else}}{{disabled (not ../editable)}}{{/if}}>
            <i class="fa-solid fa-dice-d10" aria-hidden="true"></i>
          </button>
          </div>
          {{#if ../editingAttributes}}{{#if attribute.modified}}
          <small class="witcher-effective">{{localize "WITCHER.Statistics.Total"}}: {{attribute.effective}}</small>
          {{/if}}{{/if}}
        </div>
        {{/each}}
      </div>
      </section>
    </section>
    <section id="{{rootId}}-skills" class="witcher-character-content witcher-skills tab {{tabs.skills.cssClass}}"
             data-group="character" data-tab="skills" aria-label="{{localize 'WITCHER.Skills.Title'}}">
      <div class="witcher-skills-heading">
        <h2>{{localize "WITCHER.Skills.Title"}}</h2>
        <button type="button" data-action="toggleSkills" role="switch" aria-checked="{{skills.editing}}" {{disabled (not editable)}}>
          <i class="fa-solid {{#if skills.editing}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i> {{localize "WITCHER.Skills.Edit"}}
        </button>
      </div>
      <div class="witcher-skill-rules">{{localize "WITCHER.Skills.Rules"}}</div>
      <div class="witcher-ability-controls">
        {{#if abilities.hasTrust}}
        <button type="button" class="witcher-trust {{#if abilities.trustEnabled}}enabled{{/if}}" data-action="toggleTrust" role="switch"
                aria-checked="{{abilities.trustEnabled}}" data-tooltip="{{localize 'WITCHER.Abilities.TrustHint'}}" {{disabled (not editable)}}>
          <i class="fa-regular {{#if abilities.trustEnabled}}fa-square-check{{else}}fa-square{{/if}}" aria-hidden="true"></i> {{localize "WITCHER.Abilities.TrustToggle"}}
        </button>
        {{/if}}
        {{#if abilities.hasStubbornness}}
        <div class="witcher-stubbornness">
          <span data-tooltip="{{localize 'WITCHER.Abilities.CounterHint'}}" tabindex="0">{{localize "WITCHER.Abilities.Stubbornness"}}</span>
          <strong>{{abilities.remaining}}</strong>
          <button type="button" data-action="stubbornness" data-change="1" title="{{localize 'WITCHER.Abilities.Use'}}" aria-label="{{localize 'WITCHER.Abilities.Use'}}" {{#if abilities.exhausted}}disabled{{else}}{{disabled (not editable)}}{{/if}}><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
          <button type="button" data-action="stubbornness" data-change="-1" title="{{localize 'WITCHER.Abilities.Restore'}}" aria-label="{{localize 'WITCHER.Abilities.Restore'}}" {{#if abilities.full}}disabled{{else}}{{disabled (not editable)}}{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
          <button type="button" data-action="stubbornness" data-change="0" title="{{localize 'WITCHER.Abilities.Reset'}}" aria-label="{{localize 'WITCHER.Abilities.Reset'}}" {{#if abilities.full}}disabled{{else}}{{disabled (not editable)}}{{/if}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
        </div>
        {{/if}}
      </div>
      <details class="witcher-sheet-abilities" data-biography-section="abilities" {{#if abilitiesOpen}}open{{/if}}>
        <summary>{{localize "WITCHER.Abilities.Title"}} <small>{{abilities.entries.length}}</small></summary>
        <div class="witcher-abilities-toolbar">
          <button type="button" data-action="browseAbilities"><i class="fa-solid fa-book-atlas" aria-hidden="true"></i> {{localize "WITCHER.Abilities.Browse"}}</button>
          <button type="button" data-action="createAbility" {{disabled (not editable)}}><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "WITCHER.Abilities.Create"}}</button>
        </div>
        <p class="witcher-drop-hint">{{localize "WITCHER.Abilities.Hint"}}</p>
        {{#each abilities.entries as |ability|}}
        <details class="witcher-owned-ability {{#if ability.id}}draggable{{/if}} {{#if ability.suppressed}}is-suppressed{{/if}}" data-item-id="{{ability.id}}">
          <summary>
            <img src="{{ability.img}}" alt=""><span>{{ability.name}}</span>
            {{#if ability.fromRace}}<small>{{localize "WITCHER.Abilities.Race"}}</small>{{/if}}
            {{#if ability.suppressed}}<small class="witcher-suppression-hint" data-tooltip="{{localize 'WITCHER.Visor.SensesHint'}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{localize "WITCHER.Visor.SensesInactive"}}</small>{{/if}}
          </summary>
          {{#if ability.suppressed}}<p class="witcher-suppression-hint">{{localize "WITCHER.Visor.SensesHint"}}</p>{{/if}}
          <div class="witcher-owned-description">{{{ability.description}}}</div>
          <div class="witcher-owned-buttons">
            <button type="button" data-action="viewSheetItem" data-item-id="{{ability.id}}" data-uuid="{{ability.uuid}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> {{localize "WITCHER.Abilities.View"}}</button>
            {{#if ability.id}}{{#if ../editable}}<button type="button" data-action="removeSheetItem" data-item-id="{{ability.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "WITCHER.Abilities.Remove"}}</button>{{/if}}{{/if}}
          </div>
        </details>
        {{else}}<p class="witcher-drop-hint">{{localize "WITCHER.Abilities.Empty"}}</p>{{/each}}
      </details>
      <label class="witcher-skills-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" data-skill-search value="{{skills.query}}" placeholder="{{localize 'WITCHER.Skills.Search'}}" aria-label="{{localize 'WITCHER.Skills.Search'}}">
      </label>
      {{#each skills.groups as |group|}}
      <section class="witcher-skill-group" data-skill-group {{#unless group.visible}}hidden{{/unless}}>
        <h3>{{localize group.label}}</h3>
        <table class="witcher-skills-table">
          <thead><tr><th>{{localize "WITCHER.Skills.Name"}}</th><th>{{localize "WITCHER.Skills.Level"}}</th><th>{{localize "WITCHER.Skills.Attribute"}}</th><th>{{localize "WITCHER.Skills.Bonus"}}</th><th>{{localize "WITCHER.Skills.Base"}}</th><th></th></tr></thead>
          <tbody>
            {{#each group.rows as |skill|}}
            <tr data-skill-name="{{skill.searchName}}" {{#unless skill.visible}}hidden{{/unless}}>
              <td><span class="witcher-skill-label" data-tooltip="{{skill.tooltip}}" tabindex="0">{{skill.label}}{{#if skill.complex}} <small>(2)</small>{{/if}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></td>
              <td>{{#if ../../skills.editing}}<input name="system.skills.{{skill.key}}" type="number" min="0" step="1" value="{{skill.level}}" aria-label="{{skill.label}} — {{localize 'WITCHER.Skills.Level'}}">{{else}}<output>{{skill.level}}</output>{{/if}}</td>
              <td><span title="{{localize skill.attributeShort}}">{{skill.attributeText}}</span></td>
              <td><output class="{{#if skill.bonus}}has-bonus{{/if}}" data-tooltip="{{skill.calculation}}" tabindex="0">{{skill.bonusText}}</output></td>
              <td><output class="witcher-skill-total" data-tooltip="{{skill.calculation}}" tabindex="0">{{skill.total}}</output></td>
              <td><button type="button" data-action="rollSkill" data-skill="{{skill.key}}" title="{{skill.rollHint}}" aria-label="{{skill.rollHint}}" {{#if skill.rollUnavailable}}disabled{{else}}{{disabled (not ../../editable)}}{{/if}}><i class="fa-solid fa-dice-d10" aria-hidden="true"></i></button></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      {{/each}}
      <div class="witcher-languages-heading">
        <h3><span data-tooltip="{{skills.languageTooltip}}" tabindex="0">{{localize "WITCHER.Skills.Languages"}} (2) <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></h3>
        <button type="button" data-action="browseLanguages" title="{{localize 'WITCHER.Languages.Browse'}}" aria-label="{{localize 'WITCHER.Languages.Browse'}}"><i class="fa-solid fa-book-atlas" aria-hidden="true"></i> {{localize "WITCHER.Languages.Compendium"}}</button>
        <button type="button" data-action="addLanguage" title="{{localize 'WITCHER.Skills.AddLanguage'}}" {{disabled (not editable)}}><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "WITCHER.Skills.AddLanguage"}}</button>
      </div>
      <div data-skill-group>
        {{#each skills.languages as |skill|}}
        <div class="witcher-language-row" data-skill-name="{{skill.searchName}}" {{#unless skill.visible}}hidden{{/unless}}>
          {{#if ../skills.editing}}
          {{#if skill.core}}<span class="witcher-language-name">{{skill.label}}{{#if skill.native}} <small class="witcher-language-native">родной</small>{{/if}}</span>
          {{else}}<input type="text" data-language-field="name" data-language-id="{{skill.languageId}}" value="{{skill.label}}" aria-label="{{localize 'WITCHER.Skills.LanguageName'}}" required>{{/if}}
          <input type="number" data-language-field="level" data-language-id="{{skill.languageId}}" value="{{skill.level}}" min="0" step="1" aria-label="{{skill.label}} — {{localize 'WITCHER.Skills.Level'}}">
          {{else}}<span class="witcher-language-name">{{skill.label}}{{#if skill.native}} <small class="witcher-language-native">родной</small>{{/if}}</span><span>{{localize "WITCHER.Skills.Level"}} {{skill.level}}</span>{{/if}}
          <output class="witcher-skill-total" data-tooltip="{{skill.calculation}}" tabindex="0">{{skill.total}}</output>
          <button type="button" data-action="rollSkill" data-skill="language" data-language-id="{{skill.languageId}}" title="{{skill.rollHint}}" aria-label="{{skill.rollHint}}" {{#if skill.rollUnavailable}}disabled{{else}}{{disabled (not ../editable)}}{{/if}}><i class="fa-solid fa-dice-d10" aria-hidden="true"></i></button>
          {{#if ../skills.editing}}{{#unless skill.core}}<button type="button" data-action="removeLanguage" data-language-id="{{skill.languageId}}" title="{{localize 'WITCHER.Skills.RemoveLanguage'}}" aria-label="{{localize 'WITCHER.Skills.RemoveLanguage'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}{{/if}}
        </div>
        {{/each}}
      </div>
      <p class="witcher-drop-hint" data-no-skills {{#unless skills.empty}}hidden{{/unless}}>{{localize "WITCHER.Skills.NoResults"}}</p>
    </section>
    <section id="{{rootId}}-crafting" class="witcher-character-content witcher-crafting-page tab {{tabs.crafting.cssClass}}" data-group="character" data-tab="crafting" aria-label="{{localize 'WITCHER.Crafting.Title'}}">
      {{> "systems/witcher-eliott-system/templates/crafting.hbs"}}
    </section>
    <section id="{{rootId}}-alchemy" class="witcher-character-content witcher-crafting-page witcher-alchemy-page tab {{tabs.alchemy.cssClass}}" data-group="character" data-tab="alchemy" aria-label="{{localize 'WITCHER.Alchemy.Title'}}">
      {{> "systems/witcher-eliott-system/templates/alchemy.hbs"}}
    </section>
    <section id="{{rootId}}-transport" class="witcher-character-content witcher-transport tab {{tabs.transport.cssClass}}" data-group="character" data-tab="transport" aria-label="{{localize 'WITCHER.Transport.Title'}}">
      {{> "systems/witcher-eliott-system/templates/transport.hbs"}}
    </section>
    <section id="{{rootId}}-magic" class="witcher-character-content witcher-magic-page tab {{tabs.magic.cssClass}}" data-group="character" data-tab="magic" aria-label="Магия">
      {{> "systems/witcher-eliott-system/templates/magic.hbs"}}
      {{> "systems/witcher-eliott-system/templates/learning.hbs"}}
    </section>
    <section id="{{rootId}}-inventory" class="witcher-character-content witcher-inventory tab {{tabs.inventory.cssClass}}"
             data-group="character" data-tab="inventory" aria-label="{{localize 'WITCHER.Inventory.Title'}}">
      {{> "systems/witcher-eliott-system/templates/inventory.hbs"}}
    </section>
    <section id="{{rootId}}-profession" class="witcher-character-content witcher-profession-page tab {{tabs.profession.cssClass}}"
             data-group="character" data-tab="profession" aria-label="{{localize 'WITCHER.Professions.Title'}}">
      {{> "systems/witcher-eliott-system/templates/profession.hbs"}}
    </section>
    <section id="{{rootId}}-actions" class="witcher-character-content tab {{tabs.actions.cssClass}}"
             data-group="character" data-tab="actions" aria-label="{{localize 'WITCHER.Actions.Title'}}">
      {{> "systems/witcher-eliott-system/templates/combat-actions.hbs"}}
    </section>
    <section id="{{rootId}}-biography" class="witcher-character-content witcher-biography tab {{tabs.biography.cssClass}}"
             data-group="character" data-tab="biography" aria-label="{{localize 'WITCHER.Sheet.Biography'}}">
      <details class="witcher-biography-section" data-biography-section="influential-friend" {{#if friendSectionOpen}}open{{/if}}>
        <summary>{{localize "WITCHER.Sheet.InfluentialFriend"}} <small class="witcher-optional">{{localize "WITCHER.Sheet.Optional"}}</small></summary>
        <div class="witcher-reference-value">
          {{#if selectedFriend}}
          <button type="button" class="witcher-select-reference" data-action="viewFriend" title="{{localize 'WITCHER.Sheet.ViewFriend'}}">
            <span>{{localize selectedFriend.label}}</span>
            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
          </button>
          {{else}}
          <span class="witcher-select-reference">{{localize "WITCHER.Sheet.FriendUnset"}}</span>
          {{/if}}
          <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="influentialFriend"
                  aria-label="{{localize 'WITCHER.Sheet.ChooseFriend'}}" title="{{localize 'WITCHER.Sheet.ChooseFriend'}}" {{disabled (not editable)}}>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </button>
        </div>
      </details>
      {{#each biographySections as |section|}}
      <details class="witcher-biography-section" data-biography-section="{{section.id}}" {{#if section.open}}open{{/if}}>
        <summary id="{{../rootId}}-{{section.id}}-title">{{localize section.label}}</summary>
        <textarea id="{{../rootId}}-{{section.id}}" name="system.{{section.path}}" rows="{{section.rows}}"
                  aria-labelledby="{{../rootId}}-{{section.id}}-title" {{disabled (not ../editable)}}>{{section.value}}</textarea>
      </details>
      {{/each}}
    </section>
    <section id="{{rootId}}-family" class="witcher-character-content witcher-biography tab {{tabs.family.cssClass}}"
             data-group="character" data-tab="family" aria-label="{{localize 'WITCHER.Sheet.Family'}}">
      {{#each familySections as |section|}}
      <details class="witcher-biography-section" data-biography-section="{{section.id}}" {{#if section.open}}open{{/if}}>
        <summary id="{{../rootId}}-{{section.id}}-title">{{localize section.label}}</summary>
        <textarea id="{{../rootId}}-{{section.id}}" name="system.{{section.path}}" rows="{{section.rows}}"
                  aria-labelledby="{{../rootId}}-{{section.id}}-title" {{disabled (not ../editable)}}>{{section.value}}</textarea>
      </details>
      {{/each}}
    </section>
    <section id="{{rootId}}-lifepath" class="witcher-character-content witcher-lifepath tab {{tabs.lifepath.cssClass}}" data-group="character" data-tab="lifepath" aria-label="{{localize 'WITCHER.Lifepath.Title'}}">
      {{> "systems/witcher-eliott-system/templates/lifepath.hbs"}}
    </section>
    <section id="{{rootId}}-effects" class="witcher-character-content witcher-effects tab {{tabs.effects.cssClass}}"
             data-group="character" data-tab="effects" aria-label="{{localize 'WITCHER.Sheet.Effects'}}">
      {{> "systems/witcher-eliott-system/templates/effects-list.hbs"}}
    </section>
  </div>
</div>
