<div class="witcher-character-layout">
  <aside class="witcher-character-sidebar">
    <div class="witcher-brand">THE WITCHER</div>
    <section class="witcher-resources" aria-label="{{localize 'WITCHER.Sheet.Resources'}}">
    <fieldset class="witcher-resource health">
      <legend><span data-tooltip="{{stats.healthTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Sheet.Health"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></legend>
      <div class="witcher-resource-values">
        <label for="{{rootId}}-health-value">{{localize "WITCHER.Sheet.Current"}}
          <input id="{{rootId}}-health-value" type="number" name="system.health.value"
                 value="{{system.health.value}}" step="1" {{disabled (not editable)}}>
        </label>
        <span aria-hidden="true">/</span>
        <label for="{{rootId}}-health-max">{{localize "WITCHER.Sheet.Maximum"}}
          {{#if stats.physicalReady}}
          <output id="{{rootId}}-health-max">{{system.health.max}}</output>
          {{else}}
          <input id="{{rootId}}-health-max" type="number" name="system.health.max"
                 value="{{system.health.max}}" min="0" step="1" {{disabled (not editable)}}>
          {{/if}}
        </label>
      </div>
    </fieldset>
    <div class="witcher-stat-row witcher-resource-detail">
      <span data-tooltip="{{stats.woundThreshold.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize stats.woundThreshold.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
      <strong>{{stats.woundThreshold.value}}</strong>
    </div>
    {{#if stats.wounded}}<p class="witcher-wound-notice" role="status">{{localize stats.woundNotice}}</p>{{/if}}
    {{#if stats.death.dead}}
    <section class="witcher-death-state dead" role="status">
      <h3><i class="fa-solid fa-skull" aria-hidden="true"></i> {{localize "WITCHER.Effects.Dead"}}</h3>
      <p>{{localize "WITCHER.Death.DeadNotice"}}</p>
    </section>
    {{else if stats.death.active}}
    <section class="witcher-death-state" aria-label="{{localize 'WITCHER.Effects.Dying'}}">
      <h3><i class="fa-solid fa-skull" aria-hidden="true"></i> {{localize "WITCHER.Effects.Dying"}}</h3>
      <p>{{localize "WITCHER.Death.Penalties"}}</p>
      <div class="witcher-stat-row">
        <label for="{{rootId}}-death-penalty">{{localize "WITCHER.Death.Penalty"}}</label>
        {{#if canEditDeathPenalty}}
        <input id="{{rootId}}-death-penalty" type="number" name="system.death.penalty" min="0" step="1" value="{{stats.death.penalty}}">
        {{else}}<output id="{{rootId}}-death-penalty">{{stats.death.penalty}}</output>{{/if}}
      </div>
      <div class="witcher-stat-row">
        <span data-tooltip="{{stats.death.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Death.Target"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
        <strong>&lt; {{stats.death.target}}</strong>
      </div>
      <button type="button" class="witcher-stun-roll" data-action="rollDeath"
              {{#if stats.stunUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
        <i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Death.Roll"}}
      </button>
    </section>
    {{/if}}
    <fieldset class="witcher-resource stamina">
      <legend><span data-tooltip="{{stats.staminaTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Sheet.Stamina"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></legend>
      <div class="witcher-resource-values">
        <label for="{{rootId}}-stamina-value">{{localize "WITCHER.Sheet.Current"}}
          <input id="{{rootId}}-stamina-value" type="number" name="system.stamina.value"
                 value="{{system.stamina.value}}" min="0" step="1" {{disabled (not editable)}}>
        </label>
        <span aria-hidden="true">/</span>
        <label for="{{rootId}}-stamina-max">{{localize "WITCHER.Sheet.Maximum"}}
          {{#if stats.physicalReady}}
          <output id="{{rootId}}-stamina-max">{{system.stamina.max}}</output>
          {{else}}
          <input id="{{rootId}}-stamina-max" type="number" name="system.stamina.max"
                 value="{{system.stamina.max}}" min="0" step="1" {{disabled (not editable)}}>
          {{/if}}
        </label>
      </div>
    </fieldset>
    <div class="witcher-stat-row witcher-resource-detail">
      <span data-tooltip="{{stats.recovery.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize stats.recovery.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
      <strong>{{stats.recovery.value}}</strong>
    </div>
  </section>
    <section class="witcher-derived" aria-label="{{localize 'WITCHER.Statistics.Physical'}}">
      <div class="witcher-stat-row">
        <span data-tooltip="{{stats.stunTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Statistics.Stun"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span><strong>{{stats.stunValue}}</strong>
      </div>
      <button type="button" class="witcher-stun-roll" data-action="rollStun"
              {{#if stats.stunUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
        <i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Statistics.RollStun"}}
      </button>
    </section>
    <section class="witcher-derived" aria-label="{{localize 'WITCHER.Statistics.Combat'}}">
      {{#each stats.movementRows as |stat|}}
      <div class="witcher-stat-row">
        <span data-tooltip="{{stat.tooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize stat.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span><strong>{{stat.value}} {{stat.unit}}</strong>
      </div>
      {{/each}}
      <div class="witcher-stat-entry">
        <span data-tooltip="{{stats.carryTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Statistics.Carry"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
        <div class="witcher-stat-entry-value">
          <output id="{{rootId}}-weight">{{stats.carriedWeight}} / {{stats.carryMax}} {{localize "WITCHER.Statistics.Kilograms"}}</output>
        </div>
      </div>
      <div class="witcher-stat-entry">
        <label for="{{rootId}}-vigor"><span data-tooltip="{{stats.vigorTooltip}}" data-tooltip-direction="RIGHT" tabindex="0">{{localize "WITCHER.Statistics.Vigor"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></span></label>
        <input id="{{rootId}}-vigor" name="system.vigor" type="number" min="0" step="1"
               value="{{system.vigor}}" {{disabled (not editable)}}>
      </div>
    </section>
  </aside>
  <div class="witcher-character-main">
    <header class="witcher-character-name">
      <label class="witcher-sr-only" for="{{rootId}}-name">{{localize "WITCHER.Sheet.Name"}}</label>
      <input id="{{rootId}}-name" name="name" type="text" value="{{actor.name}}" required {{disabled (not editable)}}>
      <div class="witcher-luck">
        <div class="witcher-luck-heading">
          <label for="{{rootId}}-luck" data-tooltip="{{stats.luck.tooltip}}" tabindex="0">{{localize "WITCHER.Attributes.luck.Label"}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i></label>
          {{#if editingAttributes}}
          <input id="{{rootId}}-luck" name="system.attributes.luck" type="number" min="0" max="100" step="1"
                 value="{{system.attributes.luck}}" placeholder="—" aria-label="{{localize 'WITCHER.Statistics.Base'}}" data-tooltip="{{stats.luck.valueTooltip}}">
          {{/if}}
          <output {{#unless editingAttributes}}id="{{rootId}}-luck"{{/unless}} class="witcher-luck-remaining" data-tooltip="{{stats.luck.valueTooltip}}" tabindex="0">{{stats.luck.available}} / {{stats.luck.maximum}}</output>
          {{#if stats.luck.pending}}<span class="witcher-luck-selected">+{{stats.luck.pending}} {{localize "WITCHER.Luck.NextRoll"}}</span>{{/if}}
          <button type="button" class="witcher-attribute-roll" data-action="rollAttribute" data-attribute="luck"
                  title="{{stats.luck.rollHint}}" aria-label="{{stats.luck.rollHint}}" {{#if stats.luck.unset}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
            <i class="fa-solid fa-dice-d10" aria-hidden="true"></i>
          </button>
          <button type="button" class="witcher-reset-luck" data-action="resetLuck" title="{{localize 'WITCHER.Luck.Reset'}}"
                  aria-label="{{localize 'WITCHER.Luck.Reset'}}" {{disabled (not editable)}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
        </div>
        <div class="witcher-luck-points" role="group" aria-label="{{localize 'WITCHER.Luck.Points'}}">
          {{#each stats.luck.points as |point|}}
          <button type="button" class="witcher-luck-point {{#if point.spent}}spent{{/if}} {{#if point.selected}}selected{{/if}}" data-action="toggleLuck" data-point="{{point.number}}"
                  aria-pressed="{{point.selected}}" aria-label="{{localize 'WITCHER.Luck.Point'}} {{point.number}}" {{#if point.spent}}disabled{{else}}{{disabled (not ../editable)}}{{/if}}>{{point.number}}</button>
          {{/each}}
        </div>
      </div>
    </header>
    <nav class="witcher-character-tabs tabs" aria-label="{{localize 'WITCHER.Sheet.Title'}}">
      {{#each visibleTabs as |tab|}}
      <button type="button" class="{{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
              aria-pressed="{{tab.active}}" aria-controls="{{../rootId}}-{{tab.id}}">
        <i class="{{tab.icon}}" aria-hidden="true"></i>
        <span>{{localize tab.label}}</span>
      </button>
      {{/each}}
      <button type="button" class="witcher-manage-tabs" data-action="configureTabs"
              title="{{localize 'WITCHER.Sheet.ManageTabs'}}" aria-label="{{localize 'WITCHER.Sheet.ManageTabs'}}">
        <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
      </button>
    </nav>
    <section id="{{rootId}}-main" class="witcher-character-content tab {{tabs.main.cssClass}}" data-group="character" data-tab="main"
             aria-label="{{localize 'WITCHER.Sheet.Main'}}">
      <div class="witcher-character-hero">
        <div class="witcher-portrait-frame">
          <button type="button" class="witcher-portrait-button" data-action="showPortraitArtwork"
                  aria-label="{{localize 'WITCHER.Sheet.ViewPortrait'}}" title="{{localize 'WITCHER.Sheet.ViewPortrait'}}">
            <img class="witcher-portrait" src="{{actor.img}}" alt="{{actor.name}}">
          </button>
          {{#if editable}}
          <button type="button" class="witcher-edit-portrait" data-action="editPortrait"
                  aria-label="{{localize 'WITCHER.Sheet.Portrait'}}" title="{{localize 'WITCHER.Sheet.Portrait'}}">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
          </button>
          {{/if}}
        </div>
        <div class="witcher-character-references">
          <div class="witcher-reference-field">
            <span class="witcher-field-label">{{localize "WITCHER.Sheet.Race"}}</span>
            <div class="witcher-reference-value">
              {{#if selectedRace}}
              <button type="button" class="witcher-select-reference" data-action="viewRace"
                      title="{{localize 'WITCHER.Sheet.ViewRace'}}">
                <span>{{localize selectedRace.label}}</span>
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
              </button>
              {{else}}
              <span class="witcher-select-reference">{{localize "WITCHER.Sheet.RaceUnset"}}</span>
              {{/if}}
              <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="race"
                      aria-label="{{localize 'WITCHER.Sheet.ChooseRace'}}" title="{{localize 'WITCHER.Sheet.ChooseRace'}}" {{disabled (not editable)}}>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div class="witcher-reference-field">
            <span class="witcher-field-label">{{localize "WITCHER.Sheet.Origin"}}</span>
            <div class="witcher-reference-value">
              {{#if selectedOrigin}}
              <button type="button" class="witcher-select-reference" data-action="viewOrigin"
                      title="{{localize 'WITCHER.Sheet.ViewOrigin'}}">
                <span>{{localize selectedOrigin.label}}</span>
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
              </button>
              {{else}}
              <span class="witcher-select-reference">{{localize "WITCHER.Sheet.OriginUnset"}}</span>
              {{/if}}
              <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="origin"
                      aria-label="{{localize 'WITCHER.Sheet.ChooseOrigin'}}" title="{{localize 'WITCHER.Sheet.ChooseOrigin'}}" {{disabled (not editable)}}>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
            {{#if originExcluded}}<p class="witcher-origin-excluded" role="note">{{localize "WITCHER.Sheet.OriginExcluded"}}</p>{{/if}}
          </div>
          {{#if showFamilyStatus}}
          <div class="witcher-reference-field">
            <span class="witcher-field-label">{{localize "WITCHER.Sheet.FamilyStatus"}}</span>
            <div class="witcher-reference-value">
              {{#if selectedFamilyStatus}}
              <button type="button" class="witcher-select-reference" data-action="viewFamilyStatus"
                      title="{{localize 'WITCHER.Sheet.ViewFamilyStatus'}}">
                <span>{{localize selectedFamilyStatus.label}}</span>
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
              </button>
              {{else}}
              <span class="witcher-select-reference">{{localize "WITCHER.Sheet.FamilyStatusUnset"}}</span>
              {{/if}}
              <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="familyStatus"
                      aria-label="{{localize 'WITCHER.Sheet.ChooseFamilyStatus'}}" title="{{localize 'WITCHER.Sheet.ChooseFamilyStatus'}}" {{disabled (not editable)}}>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          {{/if}}
        </div>
      </div>
      <div class="witcher-demographics">
        <label for="{{rootId}}-gender">{{localize "WITCHER.Sheet.Gender"}}
          <input id="{{rootId}}-gender" name="system.details.gender" type="text" value="{{system.details.gender}}" {{disabled (not editable)}}>
        </label>
        <label for="{{rootId}}-age">{{localize "WITCHER.Sheet.Age"}}
          <input id="{{rootId}}-age" name="system.details.age" type="number" min="0" step="1"
                 value="{{system.details.age}}" placeholder="—" {{disabled (not editable)}}>
        </label>
      </div>
      <section class="witcher-parameters" aria-label="{{localize 'WITCHER.Statistics.Primary'}}">
      <div class="witcher-parameters-heading">
        <h2>{{localize "WITCHER.Statistics.Primary"}}</h2>
        <button type="button" class="witcher-edit-attributes" data-action="toggleAttributes" role="switch" aria-checked="{{editingAttributes}}"
                title="{{localize 'WITCHER.Statistics.Edit'}}" {{disabled (not editable)}}>
          <i class="fa-solid {{#if editingAttributes}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>
          {{localize "WITCHER.Statistics.Edit"}}
        </button>
      </div>
      {{#if editingAttributes}}<p class="witcher-base-hint">{{localize "WITCHER.Statistics.EditHint"}}</p>{{/if}}
      <div class="witcher-attribute-grid">
        {{#each stats.attributes as |attribute|}}
        <div class="witcher-attribute {{#if attribute.reduced}}reduced{{/if}}">
          <span class="witcher-attribute-short">{{localize attribute.short}}</span>
          <label class="witcher-attribute-name" for="{{../rootId}}-attribute-{{attribute.key}}" data-tooltip="{{attribute.tooltip}}" tabindex="0">
            {{localize attribute.label}} <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
          </label>
          <div class="witcher-attribute-value">
          {{#if ../editingAttributes}}
          <input id="{{../rootId}}-attribute-{{attribute.key}}" name="system.attributes.{{attribute.key}}" type="number"
                 min="0" max="100" step="1" value="{{attribute.value}}" placeholder="—" data-tooltip="{{attribute.valueTooltip}}">
          {{else}}
          <output id="{{../rootId}}-attribute-{{attribute.key}}" data-tooltip="{{attribute.valueTooltip}}" tabindex="0">{{attribute.effective}}</output>
          {{/if}}
          <button type="button" class="witcher-attribute-roll" data-action="rollAttribute" data-attribute="{{attribute.key}}"
                  title="{{attribute.rollHint}}" aria-label="{{attribute.rollHint}}" {{#if attribute.unset}}disabled{{else}}{{disabled (not ../editable)}}{{/if}}>
            <i class="fa-solid fa-dice-d10" aria-hidden="true"></i>
          </button>
          </div>
          {{#if ../editingAttributes}}{{#if attribute.modified}}
          <small class="witcher-effective">{{localize "WITCHER.Statistics.Total"}}: {{attribute.effective}}</small>
          {{/if}}{{/if}}
        </div>
        {{/each}}
      </div>
      </section>
    </section>
    <section id="{{rootId}}-biography" class="witcher-character-content witcher-biography tab {{tabs.biography.cssClass}}"
             data-group="character" data-tab="biography" aria-label="{{localize 'WITCHER.Sheet.Biography'}}">
      <details class="witcher-biography-section" data-biography-section="influential-friend" {{#if friendSectionOpen}}open{{/if}}>
        <summary>{{localize "WITCHER.Sheet.InfluentialFriend"}} <small class="witcher-optional">{{localize "WITCHER.Sheet.Optional"}}</small></summary>
        <div class="witcher-reference-value">
          {{#if selectedFriend}}
          <button type="button" class="witcher-select-reference" data-action="viewFriend" title="{{localize 'WITCHER.Sheet.ViewFriend'}}">
            <span>{{localize selectedFriend.label}}</span>
            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
          </button>
          {{else}}
          <span class="witcher-select-reference">{{localize "WITCHER.Sheet.FriendUnset"}}</span>
          {{/if}}
          <button type="button" class="witcher-reference-inspect" data-action="chooseReference" data-kind="influentialFriend"
                  aria-label="{{localize 'WITCHER.Sheet.ChooseFriend'}}" title="{{localize 'WITCHER.Sheet.ChooseFriend'}}" {{disabled (not editable)}}>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </button>
        </div>
      </details>
      {{#each biographySections as |section|}}
      <details class="witcher-biography-section" data-biography-section="{{section.id}}" {{#if section.open}}open{{/if}}>
        <summary id="{{../rootId}}-{{section.id}}-title">{{localize section.label}}</summary>
        <textarea id="{{../rootId}}-{{section.id}}" name="system.{{section.path}}" rows="{{section.rows}}"
                  aria-labelledby="{{../rootId}}-{{section.id}}-title" {{disabled (not ../editable)}}>{{section.value}}</textarea>
      </details>
      {{/each}}
    </section>
    <section id="{{rootId}}-family" class="witcher-character-content witcher-biography tab {{tabs.family.cssClass}}"
             data-group="character" data-tab="family" aria-label="{{localize 'WITCHER.Sheet.Family'}}">
      {{#each familySections as |section|}}
      <details class="witcher-biography-section" data-biography-section="{{section.id}}" {{#if section.open}}open{{/if}}>
        <summary id="{{../rootId}}-{{section.id}}-title">{{localize section.label}}</summary>
        <textarea id="{{../rootId}}-{{section.id}}" name="system.{{section.path}}" rows="{{section.rows}}"
                  aria-labelledby="{{../rootId}}-{{section.id}}-title" {{disabled (not ../editable)}}>{{section.value}}</textarea>
      </details>
      {{/each}}
    </section>
    <section id="{{rootId}}-effects" class="witcher-character-content witcher-effects tab {{tabs.effects.cssClass}}"
             data-group="character" data-tab="effects" aria-label="{{localize 'WITCHER.Sheet.Effects'}}">
      <div class="witcher-effects-heading">
        <h2>{{localize "WITCHER.Sheet.Effects"}}</h2>
        <button type="button" data-action="addStunned" {{#if stunned}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
          <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "WITCHER.Effects.Stunned"}}
        </button>
      </div>
      {{#each effects as |effect|}}
      <article class="witcher-effect {{#if effect.inactive}}inactive{{/if}}">
        <header>
          <img src="{{effect.img}}" alt="">
          <h3>{{effect.name}} {{#if effect.inactive}}<small>{{localize "WITCHER.Effects.Inactive"}}</small>{{/if}}</h3>
          <button type="button" data-action="removeEffect" data-effect-id="{{effect.id}}" title="{{localize 'WITCHER.Effects.Remove'}}"
                  aria-label="{{localize 'WITCHER.Effects.Remove'}}" {{disabled (not effect.canRemove)}}><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="witcher-effect-description">{{{effect.description}}}</div>
      </article>
      {{else}}
      <p class="witcher-effects-empty">{{localize "WITCHER.Effects.Empty"}}</p>
      {{/each}}
      {{#if stunned}}
      <button type="button" class="witcher-recover-stun" data-action="rollStun" {{#if stats.stunUnavailable}}disabled{{else}}{{disabled (not editable)}}{{/if}}>
        <i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize "WITCHER.Effects.Recover"}}
      </button>
      {{/if}}
    </section>
  </div>
</div>
