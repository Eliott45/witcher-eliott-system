<div class="witcher-transport-toolbar"><div><h2>Транспорт</h2><p>Скакуны, упряжь и дорожный груз</p></div><div><button type="button" data-action="addTack" {{disabled (not editable)}}><i class="fa-solid fa-suitcase"></i> Упряжь</button><button type="button" data-action="addTransport" {{disabled (not editable)}}><i class="fa-solid fa-plus"></i> Транспорт</button></div></div>
<nav class="witcher-transport-fleet" aria-label="Ваш транспорт">{{#each transport.fleet}}<button type="button" data-action="selectTransport" data-item-id="{{id}}" aria-pressed="{{selected}}"><img src="{{img}}" alt=""><span>{{name}}<small>До {{capacity}} кг</small></span></button>{{/each}}</nav>
{{#with transport.selected as |carrier|}}
<article class="witcher-transport-card" data-item-id="{{carrier.id}}">
  <header class="witcher-transport-hero"><img src="{{carrier.img}}" alt=""><div><small>{{carrier.typeLabel}}</small><h3>{{carrier.name}}</h3></div><button type="button" data-action="viewSheetItem" data-item-id="{{carrier.id}}" data-tooltip="Название и параметры" aria-label="Открыть: {{carrier.name}}"><i class="fa-solid fa-pen-to-square"></i></button><button type="button" data-action="removeSheetItem" data-item-id="{{carrier.id}}" data-tooltip="Удалить транспорт; груз останется в инвентаре, не при себе" aria-label="Удалить: {{carrier.name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-trash"></i></button></header>
  <div class="witcher-transport-stats"><label>ПЗ<span><input type="number" min="0" max="{{carrier.health.max}}" data-transport-health data-item-id="{{carrier.id}}" value="{{carrier.health.value}}" aria-label="ПЗ: {{carrier.name}}" {{disabled (not ../editable)}}> / {{carrier.health.max}}</span></label><div><span>Скорость <i class="fa-regular fa-circle-question" data-tooltip="{{carrier.speedHint}}"></i></span><strong>{{carrier.speed}}</strong></div><div><span>Управление</span><strong>{{carrier.handling}}</strong></div><div><span>{{#if carrier.isMount}}Атлетика + ЛВК{{else}}Грузоподъёмность{{/if}}</span><strong>{{#if carrier.isMount}}{{carrier.athletics}}{{else}}{{carrier.capacity}} кг{{/if}}</strong></div></div>
  {{#if carrier.isWagon}}<div class="witcher-hitch"><i class="fa-solid fa-link"></i><span>{{carrier.mountName}}</span><button type="button" data-action="hitchTransport" data-item-id="{{carrier.id}}" {{disabled (not ../editable)}}>Выбрать животное</button></div>{{/if}}
  {{#if carrier.isMount}}
  <div class="witcher-hitch"><i class="fa-solid fa-cart-flatbed"></i><span>{{carrier.wagonName}}</span><small>Повозка выбирает животное в своей карточке</small></div>
  <div class="witcher-tack-slots">{{#each carrier.slots}}<button type="button" data-action="fitTack" data-item-id="{{carrier.id}}" data-slot="{{id}}" {{disabled (not ../../editable)}}><i class="fa-solid {{icon}}"></i><small>{{name}}</small><strong>{{itemName}}</strong>{{#if condition}}<span>ПБ {{condition.value}} / {{condition.max}}</span>{{/if}}</button>{{/each}}</div>
  {{/if}}
  <div class="witcher-transport-load {{#if carrier.overloaded}}overloaded{{/if}}"><span style="width:{{carrier.loadPercent}}%"></span><strong>Груз: {{carrier.contentsWeight}} / {{carrier.capacity}} кг{{#if carrier.overloaded}} · Перегруз{{/if}}</strong></div>
  <div class="witcher-cargo-toolbar"><h4><i class="fa-solid fa-box-open"></i> Груз и снаряжение</h4><button type="button" data-action="loadTransport" data-item-id="{{carrier.id}}" {{disabled (not ../editable)}}><i class="fa-solid fa-arrow-right-arrow-left"></i> Переложить</button><button type="button" data-action="transportCatalog" data-item-id="{{carrier.id}}" {{disabled (not ../editable)}}><i class="fa-solid fa-magnifying-glass"></i> Каталог</button></div>
  <div class="witcher-transport-cargo">{{#each carrier.children as |item|}}{{> "systems/witcher-eliott-system/templates/inventory-row.hbs" item=item editable=../../editable rootId=../../rootId}}{{else}}<div class="witcher-transport-empty"><i class="fa-solid fa-box-open"></i><p>Перетащите сюда вещи<br><small>Этот груз не увеличивает вес персонажа</small></p></div>{{/each}}</div>
</article>
{{else}}
<div class="witcher-transport-empty"><i class="fa-solid fa-horse"></i><h3>В путь</h3><p>Выберите животное, повозку или судно в каталоге транспорта.<br>Снаряжение и груз будут храниться здесь.</p></div>
{{/with}}
