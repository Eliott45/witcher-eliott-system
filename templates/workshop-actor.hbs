{{#if (or workshop.witcher workshop.mutations.length workshop.ready.length)}}<section class="witcher-mutations"><h2><i class="fa-solid fa-dna"></i> Мутагены <small>Свободно: {{workshop.free}} / 2</small></h2>
{{#each workshop.mutations}}<details><summary>{{name}} <span>Постоянный</span></summary>{{#if monster}}<p>Источник: {{monster}}</p>{{/if}}<p>{{properties}}</p></details>{{else}}<p>Мутагены не применены.</p>{{/each}}
{{#each workshop.ready}}<button type="button" data-action="applySheetMutagen" data-item-id="{{id}}" {{disabled (not ../editable)}} data-tooltip="Час подготовки и Алхимия СЛ {{dc}}, затем постоянный эффект (стр. 251)"><i class="fa-solid fa-dna"></i> Принять: {{name}}{{#unless prepared}} · Алхимия СЛ {{dc}}{{/unless}}</button>{{/each}}</section>{{/if}}
{{#if workshop.npc}}<section class="witcher-harvest"><h2>Добыча</h2><button type="button" data-action="addHarvest" {{disabled (not editable)}}>Добавить материал</button>
{{#if workshop.mutagenSource}}<div class="witcher-harvest-row"><span><i class="fa-solid fa-dna"></i> {{workshop.mutagenSource.name}} · Подготовка ведьмака СЛ 16</span>{{#if workshop.mutagenSource.harvested}}<span>Попытка потрачена</span>{{else}}<button type="button" data-action="harvestMutagen" {{disabled (not editable)}} data-tooltip="После убийства чудовища (стр. 251)">Вырезать мутаген</button>{{/if}}</div>{{/if}}
{{#each workshop.harvest}}<div class="witcher-harvest-row"><span>{{name}} ×{{quantity}} · СЛ {{dc}}</span>{{#if attempted}}<span>Попытка потрачена</span>{{else}}<button type="button" data-action="harvestMaterial" data-harvest-id="{{id}}" {{disabled (not ../editable)}}>Извлечь</button>{{/if}}<button type="button" data-action="removeHarvest" data-harvest-id="{{id}}" aria-label="Удалить добычу: {{name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-trash"></i></button></div>{{/each}}</section>{{/if}}
