{{#if (or workshop.witcher workshop.mutations.length workshop.ready.length)}}<section class="witcher-mutations"><h2><i class="fa-solid fa-dna"></i> Мутагены <small>Свободно: {{workshop.free}} / 2</small></h2>
{{#each workshop.mutations}}<details><summary>{{name}} <span>Постоянный</span></summary>{{#if monster}}<p>Источник: {{monster}}</p>{{/if}}<p>{{properties}}</p></details>{{else}}<p>Мутагены не применены.</p>{{/each}}
{{#each workshop.ready}}<button type="button" data-action="applySheetMutagen" data-item-id="{{id}}" {{disabled (not ../editable)}} data-tooltip="Час подготовки и Алхимия СЛ {{dc}}, затем постоянный эффект"><i class="fa-solid fa-dna"></i> Принять: {{name}}{{#unless prepared}} · Алхимия СЛ {{dc}}{{/unless}}</button>{{/each}}</section>{{/if}}
