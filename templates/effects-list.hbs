      <div class="witcher-effects-heading">
        <h2>{{localize "WITCHER.Sheet.Effects"}}</h2>
        <button type="button" data-action="browseEffects" {{disabled (not editable)}}><i class="fa-solid fa-plus" aria-hidden="true"></i> Добавить эффект</button>
      </div>
      <p class="witcher-effects-hint">Нажмите на название для проверки, на время — чтобы изменить длительность. 1 раунд = 3 секунды, 1 минута = 20 раундов. «В конце хода» выполняет одну проверку автоматически и занимает указанное действие. После ручной проверки дополнительный спас автоматически не бросается.</p>
      {{#each effects as |effect|}}
      <article class="witcher-effect {{#if effect.inactive}}inactive{{/if}}">
        <header>
          <img src="{{effect.img}}" alt="">
          <h3>{{#if effect.save}}<button class="witcher-effect-save" type="button" data-action="rollEffectSave" data-effect-id="{{effect.id}}" data-tooltip="{{effect.saveHint}} · {{effect.save.action}}" {{disabled (not effect.canSave)}}><i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{effect.name}}</button>{{else}}{{effect.name}}{{/if}} {{#if effect.inactive}}<small>{{localize "WITCHER.Effects.Inactive"}}</small>{{/if}}</h3>
          <button type="button" data-action="removeEffect" data-effect-id="{{effect.id}}" title="{{localize 'WITCHER.Effects.Remove'}}"
                  aria-label="{{localize 'WITCHER.Effects.Remove'}}" {{disabled (not effect.canRemove)}}><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="witcher-effect-description">{{{effect.description}}}</div>
        <footer class="witcher-effect-controls">
          {{#if effect.toxicity}}<span class="witcher-effect-toxicity"><i class="fa-solid fa-flask" aria-hidden="true"></i> {{localize "WITCHER.Toxicity.Title"}} +{{effect.toxicity}}%</span>{{/if}}
          {{#if effect.counter}}<span class="witcher-effect-counter"><button type="button" data-action="changeEffectCounter" data-effect-id="{{effect.id}}" data-delta="-1" aria-label="Уменьшить счётчик" {{disabled (not ../editable)}}>−</button><b>{{effect.counter.value}} / {{effect.counter.max}}</b><button type="button" data-action="changeEffectCounter" data-effect-id="{{effect.id}}" data-delta="1" aria-label="Увеличить счётчик" {{disabled (or (not ../editable) (eq effect.counter.value effect.counter.max))}}>+</button></span>{{/if}}
          {{#if effect.save}}<span class="witcher-effect-rule">{{effect.saveHint}}</span>{{/if}}
          {{#if effect.durationLabel}}<button type="button" data-action="editEffectDuration" data-effect-id="{{effect.id}}" data-tooltip="Изменить оставшееся время" {{disabled (not effect.canEditDuration)}}><i class="fa-solid fa-clock"></i> {{effect.durationLabel}}</button>{{/if}}
          {{#if effect.pending}}<span>Проверка…</span>{{/if}}
          {{#if effect.autoAllowed}}<button type="button" class="witcher-effect-auto" data-action="toggleEffectSave" data-effect-id="{{effect.id}}" aria-pressed="{{effect.autoSave}}" {{disabled (not ../editable)}}><i class="fa-solid {{#if effect.autoSave}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i> В конце хода</button>{{/if}}
          {{#if effect.critical}}<span class="witcher-wound-state is-{{effect.critical.state}}">{{effect.critical.stateLabel}}</span>{{#if effect.critical.canStabilize}}<button type="button" data-action="stabilizeWound" data-effect-id="{{effect.id}}" data-tooltip="Первая помощь против СЛ {{effect.critical.dc}}. Выделите токен лекаря, иначе — самопомощь."><i class="fa-solid fa-kit-medical"></i> Стабилизировать · СЛ {{effect.critical.dc}}</button>{{/if}}{{#if effect.critical.canTreat}}<button type="button" data-action="treatWound" data-effect-id="{{effect.id}}" data-tooltip="Медик закончил лечение (Лечащее прикосновение)"><i class="fa-solid fa-hand-holding-medical"></i> Вылечено</button>{{/if}}{{#if effect.critical.prosthesis}}<span class="witcher-wound-state is-treated">Протез: {{effect.critical.prosthesis}}</span>{{/if}}{{#if effect.critical.canFitProsthesis}}<button type="button" data-action="fitProsthesis" data-effect-id="{{effect.id}}" data-tooltip="Простой или качественный протез из инвентаря заменяет утраченную конечность"><i class="fa-solid fa-person-cane"></i> Надеть протез</button>{{/if}}{{#if effect.critical.canRemoveProsthesis}}<button type="button" data-action="removeProsthesis" data-effect-id="{{effect.id}}"><i class="fa-solid fa-xmark"></i> Снять протез</button>{{/if}}{{/if}}
          {{#if effect.weaponBlock}}<button type="button" data-action="freeWeapon" data-effect-id="{{effect.id}}" data-tooltip="Тратит действие: со вторым действием — 3 ВЫН и −3." {{disabled (not effect.canAct)}}><i class="fa-solid fa-hand"></i> Достать оружие · действие</button>{{/if}}
          {{#if effect.action}}<button type="button" data-action="effectAction" data-effect-id="{{effect.id}}" {{disabled (not effect.canAct)}}>{{effect.action}}</button>{{/if}}
        </footer>
      </article>
      {{else}}
      <p class="witcher-effects-empty">{{localize "WITCHER.Effects.Empty"}}</p>
      {{/each}}
