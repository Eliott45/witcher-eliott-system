<div class="witcher-inventory-bar">
  <label class="witcher-inventory-coins"><i class="fa-solid fa-coins" aria-hidden="true"></i> Кроны <input type="number" name="system.crowns" value="{{system.crowns}}" min="0" step="0.01" aria-label="Кроны" {{disabled (not editable)}}></label>
  <div class="witcher-inventory-bar-actions">
    <button type="button" data-action="browseEquipment" data-tooltip="Открыть компендиум предметов" aria-label="Открыть компендиум предметов"><i class="fa-solid fa-books" aria-hidden="true"></i></button>
    <button type="button" data-action="buyMaterial" data-tooltip="Купить материалы" aria-label="Купить материалы" {{disabled (not editable)}}><i class="fa-solid fa-coins" aria-hidden="true"></i></button>
    <button type="button" data-action="addCatalogItem" {{disabled (not editable)}}><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Каталог</button>
    <button type="button" data-action="createInventoryItem" data-tooltip="Создать предмет" aria-label="Создать предмет" {{disabled (not editable)}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
  </div>
</div>
{{#if inventory.showToxicity}}{{#if inventory.toxicity.visible}}<div class="witcher-toxicity {{#if inventory.toxicity.overloaded}}is-overloaded{{/if}}"><span><i class="fa-solid fa-flask"></i> {{localize "WITCHER.Toxicity.Title"}}</span><strong>{{inventory.toxicity.value}}% / {{inventory.toxicity.limit}}%</strong><progress value="{{inventory.toxicity.value}}" max="{{inventory.toxicity.limit}}" aria-label="{{localize 'WITCHER.Toxicity.Title'}}"></progress></div>{{/if}}{{/if}}
<div class="witcher-armor-zones" aria-label="Надетая броня">
{{#each inventory.zones as |zone|}}<section class="witcher-armor-zone"><h3><img class="witcher-zone-icon" src="{{zone.img}}" alt=""><span>{{zone.name}}</span></h3>
{{#each zone.items as |item|}}
<button type="button" data-action="viewSheetItem" data-item-id="{{item.id}}" data-tooltip="{{item.name}}">{{item.name}}</button><strong>ПБ {{item.condition.value}} / {{item.condition.max}}{{#if item.broken}} <span class="witcher-broken" data-tooltip="Броня сломана: ПБ 0, урон не поглощает. Почините её проверкой Изготовления.">сломана</span>{{/if}}</strong>
{{#if item.hasVisor}}
<button type="button" class="witcher-visor-toggle" data-action="toggleVisor" data-item-id="{{item.id}}" aria-pressed="{{item.visorDown}}" data-tooltip="{{#if item.visorDown}}{{localize 'WITCHER.Visor.RaiseHint'}}{{else}}{{localize 'WITCHER.Visor.LowerHint'}}{{/if}}" {{disabled (not ../../editable)}}>
  <i class="fa-solid {{#if item.visorDown}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i> {{#if item.visorDown}}{{localize "WITCHER.Visor.Down"}}{{else}}{{localize "WITCHER.Visor.Up"}}{{/if}}
</button>
{{/if}}
{{else}}<span>Не надето</span>{{/each}}{{#if zone.layered}}<p class="witcher-armor-layered" data-tooltip="Слои брони: ПБ не складываются — к сильнейшему слою добавляется бонус за разницу. Сопротивления сохраняются, но не суммируются.">Итого слоёв: <b>ПБ {{zone.total}}</b></p>{{/if}}</section>{{/each}}
</div>
{{#if inventory.layering}}<div class="witcher-armor-layering"><strong><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Слои брони: штрафы</strong><ul>{{#each inventory.layering.pieces as |piece|}}<li><span>{{piece.name}} <small>{{piece.classLabel}}</small></span><b>{{#if piece.extra}}СД +{{piece.extra}}{{else}}без надбавки{{/if}}</b></li>{{/each}}</ul><p>Надбавка за слои: <b>СД +{{inventory.layering.extra}}</b>{{#if inventory.layering.ev}} · итоговая скованность брони <b>{{inventory.layering.ev}}</b>: −{{inventory.layering.ev}} к РЕА, ЛВК, Сотворению заклинаний, Наведению порчи и Проведению ритуалов{{/if}}.</p><small>ПБ слоёв не складывается: к сильнейшему слою добавляется бонус за разницу (0–4: +5, 5–8: +4, 9–14: +3, 15–20: +2). Сопротивления слоёв сохраняются, одинаковые не суммируются. Не больше 3 слоёв на зоне, из них один средний и один тяжёлый.</small></div>{{/if}}
<label class="witcher-inventory-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-inventory-search placeholder="Поиск в инвентаре…" aria-label="Поиск в инвентаре"></label>
<div class="witcher-inventory-groups">
{{#each inventory.groups as |group|}}
<section class="witcher-inventory-group" data-inventory-group="{{group.id}}" data-collapsed="{{not group.open}}">
  <header class="witcher-inventory-group-heading">
    <button type="button" class="witcher-inventory-group-toggle" data-action="toggleInventoryGroup" data-inventory-group-id="{{group.id}}" aria-expanded="{{group.open}}" aria-controls="{{../rootId}}-inventory-{{group.id}}"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><span>{{group.name}}</span><small>{{group.items.length}}</small></button>
    <span class="witcher-inventory-column-label">Кол.</span><span class="witcher-inventory-column-label">Кг</span>
    <div class="witcher-inventory-group-actions">
      <button type="button" data-action="createInventoryItem" data-inventory-group-id="{{group.id}}" data-tooltip="Создать: {{group.name}}" aria-label="Создать: {{group.name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
      <button type="button" data-action="addCatalogItem" data-inventory-group-id="{{group.id}}" data-tooltip="Найти в каталоге: {{group.name}}" aria-label="Найти в каталоге: {{group.name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
    </div>
  </header>
  <div id="{{../rootId}}-inventory-{{group.id}}" data-inventory-group-body {{#unless group.open}}hidden{{/unless}}>
  {{#each group.items as |item|}}
    {{> "systems/witcher-eliott-system/templates/inventory-row.hbs" item=item editable=../../editable rootId=../../rootId}}
  {{/each}}
  </div>
</section>
{{/each}}
<p class="witcher-drop-hint" data-inventory-no-results hidden>Ничего не найдено.</p>
{{#unless inventory.items.length}}<p class="witcher-drop-hint">Перетащите предмет сюда или выберите его через лупу рядом с группой.</p>{{/unless}}
</div>
{{#if (or workshop.witcher workshop.npc)}}<details class="witcher-inventory-workshop" data-biography-section="inventory-workshop" {{#if inventory.workshopOpen}}open{{/if}}><summary><i class="fa-solid fa-flask" aria-hidden="true"></i> {{#if workshop.witcher}}Мутагены{{else}}Добыча{{/if}}</summary>{{> "systems/witcher-eliott-system/templates/workshop-actor.hbs"}}</details>{{/if}}
<footer class="witcher-inventory-load {{#if inventory.overloaded}}overloaded{{/if}}">
  <div><span><i class="fa-solid fa-weight-hanging" aria-hidden="true"></i> {{#if inventory.overloaded}}Перегрузка{{else}}Переносимый вес{{/if}}</span><strong>{{inventory.weight}} / {{inventory.capacity}} кг</strong></div>
  <div class="witcher-inventory-load-track" aria-hidden="true"><span style="width: {{inventory.loadPercent}}%"></span></div>
</footer>
