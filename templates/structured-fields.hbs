<div class="witcher-structured-fields">
{{#each fields as |field|}}
  <label data-record-field="{{field.name}}"><span>{{field.label}}</span>
  {{#if field.isBoolean}}<input type="checkbox" name="{{field.name}}" {{checked field.value}} {{disabled field.readOnly}} aria-label="{{field.label}}">
  {{else}}{{#if field.isChoice}}
    <select name="{{field.name}}" {{disabled field.readOnly}} aria-label="{{field.label}}"><option value="">—</option>{{#each field.choices as |option|}}<option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{localize option.name}}</option>{{/each}}</select>
  {{else}}{{#if field.isNumber}}
    <input type="number" name="{{field.name}}" value="{{field.value}}" min="{{field.min}}" step="{{#if field.step}}{{field.step}}{{else}}1{{/if}}" {{disabled field.readOnly}} aria-label="{{field.label}}">
  {{else}}
    <input type="text" name="{{field.name}}" value="{{field.value}}" {{disabled field.readOnly}} aria-label="{{field.label}}">
  {{/if}}{{/if}}{{/if}}
  <small data-field-description="{{field.name}}">{{field.description}}</small>
  </label>
{{/each}}
</div>
