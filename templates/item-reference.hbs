{{#if available}}<a class="content-link witcher-recipe-link" href="#" draggable="true" data-link data-uuid="{{uuid}}" data-type="Item" data-tooltip="Открыть: {{name}}"><img src="{{img}}" alt="" loading="lazy"><span>{{name}}</span><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{else}}<span class="witcher-recipe-unavailable"><i class="fa-solid fa-link-slash" aria-hidden="true"></i> {{name}}</span>{{/if}}
