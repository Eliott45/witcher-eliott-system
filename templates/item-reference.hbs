{{#if available}}<a class="content-link witcher-recipe-link" role="link" tabindex="0" draggable="true" data-link data-uuid="{{uuid}}" data-type="Item" data-tooltip="Открыть: {{name}}"><img src="{{img}}" alt="" loading="lazy"><span class="witcher-recipe-link-label"><span>{{name}}</span>{{#if showRarity}}{{#if rarityLabel}}<span class="witcher-item-traits witcher-recipe-rarity"><span class="is-{{rarityTone}}">{{rarityLabel}}</span></span>{{/if}}{{/if}}</span><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{else}}<span class="witcher-recipe-unavailable"><i class="fa-solid fa-link-slash" aria-hidden="true"></i> {{name}}</span>{{/if}}
