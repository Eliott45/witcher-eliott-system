<div class="witcher-magic-filters">
  <label class="witcher-magic-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-magic-search placeholder="Найти магию…" aria-label="Поиск магии"></label>
  <select data-magic-tradition aria-label="Вид магии"><option value="">Вся магия</option>{{#each traditions}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
  <select data-magic-element aria-label="Стихия"><option value="">Все стихии</option>{{#each elements}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
  <select data-magic-grade aria-label="Уровень"><option value="">Все уровни</option>{{#each grades}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
  <select data-magic-target aria-label="Цель"><option value="">Все цели</option>{{#each targets}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
</div>
