<div class="witcher-item-layout">
  <header class="witcher-reference-header">
    <img src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
    <div>
      <span class="witcher-eyebrow">{{localize typeLabel}}</span>
      {{#if editable}}
      <input name="name" type="text" value="{{item.name}}" required aria-label="{{localize 'WITCHER.Sheet.Name'}}">
      {{else}}
      <h1>{{item.name}}</h1>
      {{/if}}
    </div>
  </header>
  {{#if itemStats.length}}<dl class="witcher-item-stats">{{#each itemStats}}<div class="{{#if tone}}is-{{tone}}{{/if}}"><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>{{/if}}
  {{#if itemTraits.length}}<div class="witcher-item-traits" aria-label="Свойства для поиска">{{#each itemTraits}}<button type="button" class="is-{{tone}}" data-action="searchItemTrait" data-trait="{{label}}" data-tooltip="{{description}} Нажмите, чтобы найти похожие предметы.">{{label}}</button>{{/each}}</div>{{/if}}
  {{#if spell}}<div class="witcher-spell-info"><strong>{{spell.elementLabel}} · {{spell.gradeLabel}}{{#if spell.deity}} · {{spell.deity}}{{/if}}</strong><span>{{spell.cost}}</span><span>{{spell.range}}</span><span>{{spell.duration}}</span><span>Цель: {{spell.target}}</span><span>Защита: {{spell.defense}}</span></div>{{/if}}
  <nav class="witcher-item-tabs tabs" aria-label="{{localize 'WITCHER.ItemTabs.Navigation'}}">{{#each itemTabs}}<button type="button" data-action="tab" data-group="{{group}}" data-tab="{{id}}" class="{{cssClass}}" aria-pressed="{{active}}"><i class="{{icon}}"></i> {{localize label}}</button>{{/each}}</nav>
  <section class="witcher-item-tab tab {{tabs.description.cssClass}}" data-group="item" data-tab="description">
  {{#if consumption.enabled}}<div class="witcher-consume-controls"><button type="button" data-action="useConsumable" {{disabled (or (not editable) (not consumption.canUse))}}><i class="fa-solid fa-hand-sparkles"></i> Использовать</button><span>Осталось применений: {{consumption.remaining}}</span></div>{{/if}}
  {{{alchemyDetails}}}
  {{{materialDetails}}}
  {{#if relicLore}}<div class="witcher-consume-controls"><button type="button" data-action="rollRelicLore"><i class="fa-solid fa-book-open"></i> Вспомнить легенду · Образование СЛ {{relicLore.dc}}</button></div>{{/if}}
  {{#if recipeDetails}}{{#if recipeDetails.isRecipe}}{{> "systems/witcher-eliott-system/templates/recipe-details.hbs"}}{{/if}}{{/if}}
  {{#if isEffectItem}}
  <p class="witcher-effects-hint">Перетащите этот предмет на лист персонажа или существа, чтобы наложить эффект. Длительность и модификаторы настраиваются во вкладке «Подробности».</p>
  {{#each effectTemplates}}<section class="witcher-effect-template">
    {{#if ../editable}}<prose-mirror name="effectDescriptions.{{id}}" value="{{description}}" data-document-uuid="{{uuid}}" toggled>{{{enriched}}}</prose-mirror>
    {{else}}<div class="witcher-description">{{{enriched}}}</div>{{/if}}
  </section>{{/each}}
  {{else}}
  {{#if editable}}
  <prose-mirror name="system.description" value="{{descriptionSource}}"
                data-document-uuid="{{item.uuid}}" collaborate toggled>
    {{{description}}}
  </prose-mirror>
  {{else}}
  {{#if description}}<div class="witcher-description">{{{description}}}</div>{{/if}}
  {{/if}}
  {{/if}}
  {{#if recipeDetails}}{{#unless recipeDetails.isRecipe}}{{> "systems/witcher-eliott-system/templates/recipe-details.hbs"}}{{/unless}}{{/if}}
  {{#if spell}}<div class="witcher-spell-body">{{> "systems/witcher-eliott-system/templates/magic-requirements.hbs" spell}}</div>{{/if}}
  {{#if abilities}}
  <section aria-labelledby="{{rootId}}-abilities-title">
    <h2 id="{{rootId}}-abilities-title">{{localize "WITCHER.Sheet.RacialAbilities"}}</h2>
    <ul class="witcher-ability-list">
      {{#each abilities as |ability|}}
      <li class="witcher-ability">
        <h3>{{{ability.link}}}</h3>
        <div class="witcher-description">{{{ability.description}}}</div>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  </section>
  {{#if hasDetails}}<section class="witcher-item-tab tab {{tabs.details.cssClass}}" data-group="item" data-tab="details">
  {{#if isEffectItem}}<p class="witcher-effects-hint">1 раунд = 3 секунды · 1 минута = 20 раундов. При наложении отсчёт начинается заново.</p>
    {{#each effectTemplates}}<article class="witcher-effect-template"><h3>{{name}}</h3><div class="witcher-effect-template-actions"><button type="button" data-action="editItemEffectDuration" data-effect-id="{{id}}" {{disabled (not ../editable)}}><i class="fa-solid fa-clock"></i> {{duration}}</button><button type="button" data-action="editItemEffect" data-effect-id="{{id}}"><i class="fa-solid fa-sliders"></i> Настроить эффект</button></div></article>
    {{else}}<button type="button" data-action="addItemEffect" {{disabled (not editable)}}>Создать шаблон эффекта</button>{{/each}}
  {{/if}}
  {{#each physicalGroups as |group|}}<fieldset class="witcher-physical-fields"><legend>{{group.title}}</legend>{{> "systems/witcher-eliott-system/templates/structured-fields.hbs" fields=group.fields}}</fieldset>{{/each}}
  {{#if spell}}<label class="witcher-physical-fields">Цель (несколько — «или»)<select name="system.target" multiple {{disabled (not editable)}}>{{#each spell.targetChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
  {{#if spell}}<label class="witcher-physical-fields">Способы защиты (несколько)<select name="system.defense" multiple {{disabled (not editable)}}>{{#each spell.defenses}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
  {{#if spell}}{{#if spell.isRitual}}<section class="witcher-magic-requirements"><strong>Ингредиенты</strong>{{#each spell.components}}<div class="witcher-ritual-component"><span>{{name}} ×{{quantity}} {{#unless consumed}}· сохраняется{{/unless}}</span><button type="button" data-action="removeRitualComponent" data-index="{{index}}" aria-label="Удалить {{name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-trash"></i></button></div>{{/each}}<button type="button" data-action="addRitualComponent" {{disabled (not editable)}}><i class="fa-solid fa-plus"></i> Добавить ингредиент</button></section>{{/if}}{{/if}}
  {{#if isAbility}}<div class="witcher-item-fields"><label>{{localize "WITCHER.Skills.Level"}}<input type="number" name="system.level" min="0" max="10" step="1" value="{{system.level}}" {{disabled (not editable)}}></label><label>{{localize "WITCHER.Skills.Attribute"}}<select name="system.attribute" {{disabled (not editable)}}>{{#each attributeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>{{/if}}
  {{#if editable}}<button type="submit" class="witcher-item-save"><i class="fa-solid fa-floppy-disk"></i> {{localize "WITCHER.ItemTabs.Save"}}</button>{{/if}}
  </section>{{/if}}
  {{#if hasActions}}<section class="witcher-item-tab tab {{tabs.actions.cssClass}}" data-group="item" data-tab="actions">
  {{> "systems/witcher-eliott-system/templates/workshop-item.hbs"}}
  </section>{{/if}}
</div>
