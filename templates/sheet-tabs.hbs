<div class="witcher-tab-choices">
  <p>{{localize "WITCHER.Sheet.TabsHint"}}</p>
  {{#each tabs as |tab|}}
  <label>
    <input type="checkbox" data-sheet-tab value="{{tab.id}}" {{#if tab.visible}}checked{{/if}}>
    <i class="{{tab.icon}}" aria-hidden="true"></i>
    <span>{{localize tab.label}}</span>
  </label>
  {{/each}}
</div>
