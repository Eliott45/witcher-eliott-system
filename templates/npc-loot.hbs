<section class="witcher-npc-loot-panel" aria-label="Добыча существа">
  <header><h2><i class="fa-solid fa-sack" aria-hidden="true"></i> Добыча</h2>
    {{#if workshop.loot.isGM}}{{#if workshop.loot.hasPending}}<button type="button" data-action="creatureLoot" {{disabled (or (not editable) (not workshop.loot.canGenerate))}} data-tooltip="{{#if workshop.loot.canGenerate}}Добавить добычу в инвентарь этого существа{{else}}Добычу определяет активный ведущий{{/if}}"><i class="fa-solid fa-dice" aria-hidden="true"></i> {{#if workshop.loot.legacy}}Уточнить добычу{{else}}{{#if workshop.loot.materialsOnly}}Добавить материалы{{else}}Бросить добычу{{/if}}{{/if}}</button>{{else}}{{#if workshop.loot.generated}}<span class="witcher-npc-loot-done"><i class="fa-solid fa-check" aria-hidden="true"></i> Добыча определена</span>{{/if}}{{/if}}{{/if}}
  </header>
  <p class="witcher-npc-loot-hint">Снаряжение уже при существе. Бросок добавляет личные вещи и материалы в его инвентарь, а кроны — в кошелёк. Повторно добыча не выдаётся.</p>
  {{#if workshop.loot.hasRows}}<div class="witcher-npc-loot">
    {{#each workshop.loot.rows}}<div>{{#if ../workshop.loot.editing}}<input data-creature-list="loot" data-index="{{@index}}" data-key="name" value="{{name}}" aria-label="Название добычи"><input data-creature-list="loot" data-index="{{@index}}" data-key="formula" value="{{formula}}" aria-label="Количество добычи"><label><input type="checkbox" data-creature-list="loot" data-index="{{@index}}" data-key="currency" {{checked currency}}>Кроны</label><button type="button" data-action="removeCreatureRow" data-list="loot" data-index="{{@index}}" aria-label="Удалить добычу: {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{else}}<span>{{name}}{{#if manual}} <small>— на выбор ведущего</small>{{/if}}</span><b>{{formula}}</b>{{/if}}</div>{{/each}}
  </div><details class="witcher-npc-loot-help"><summary>Что такое обычные и странные предметы?</summary><p>Это личные вещи из таблицы «Случайные личные вещи». Сначала бросается их количество, затем за каждую вещь — 1d100 по соответствующей колонке. Например, «Обычные предметы 1d6» у бандита даёт от 1 до 6 отдельных находок. Ведущий также может выбрать вещи вручную.</p></details>{{/if}}
  {{#if workshop.loot.editing}}<button type="button" data-action="addCreatureRow" data-list="loot">Добавить строку добычи</button>{{/if}}
  {{#if workshop.loot.hasHarvest}}<h3>Материалы и трофеи</h3>{{/if}}
  {{#each workshop.harvest}}<div class="witcher-harvest-row">
    <span><b>{{name}}</b> <small>{{#if pendingRoll}}{{amount}}{{else}}×{{amount}}{{/if}}{{#if requiresCheck}} · СЛ {{dc}}{{/if}}</small></span>
    {{#if attempted}}<small>{{#if requiresCheck}}Попытка потрачена{{else}}Собрано{{/if}}</small>{{else}}{{#if requiresCheck}}<button type="button" data-action="harvestMaterial" data-harvest-id="{{id}}" {{disabled (or (not ../editable) (not canExtract))}}>{{#if pendingRoll}}Сначала бросок{{else}}Извлечь{{/if}}</button>{{else}}<small>{{#if pendingRoll}}Количество не определено{{else}}{{#if quantity}}Добавляется в инвентарь{{else}}Не выпало{{/if}}{{/if}}</small>{{/if}}{{/if}}
    {{#if ../workshop.loot.editing}}<button type="button" data-action="removeHarvest" data-harvest-id="{{id}}" aria-label="Удалить материал: {{name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}
  </div>{{/each}}
  {{#if workshop.mutagenSource}}<div class="witcher-harvest-row witcher-npc-loot-mutagen"><span><i class="fa-solid fa-dna" aria-hidden="true"></i> {{workshop.mutagenSource.name}} <small>Подготовка ведьмака · СЛ 16</small></span>{{#if workshop.mutagenSource.harvested}}<small>Попытка потрачена</small>{{else}}<button type="button" data-action="harvestMutagen" {{disabled (not editable)}} data-tooltip="После убийства чудовища">Вырезать мутаген</button>{{/if}}</div>{{/if}}
  {{#if workshop.loot.editing}}<button type="button" data-action="addHarvest" {{disabled (not editable)}}>Добавить материал</button>{{/if}}
</section>
