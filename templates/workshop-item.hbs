{{#if workshop}}
<section class="witcher-workshop-item">
{{#if workshop.canInstallRuneGlyph}}<p>Руна или глиф занимает один слот и устанавливается навсегда. Камень расходуется; установленное свойство продолжает действовать.</p><button type="button" data-action="installRuneGlyph" {{disabled (not editable)}}><i class="fa-solid fa-gem"></i> Установить на предмет</button>{{/if}}
{{#if workshop.condition}}<p>{{workshop.condition.label}}: {{workshop.condition.value}} / {{workshop.condition.max}} · с улучшениями</p>{{/if}}
{{#if workshop.bonusPath}}<h3>{{workshop.bonusHeading}}</h3>{{#each workshop.bonuses}}<p>{{label}}: {{value}} <button type="button" data-action="removeWorkshopBonus" data-index="{{index}}" {{disabled (not ../editable)}} aria-label="Удалить бонус"><i class="fa-solid fa-xmark"></i></button></p>{{/each}}<button type="button" data-action="addWorkshopBonus" {{disabled (not editable)}}>Добавить бонус</button>{{/if}}
{{#if workshop.recipe}}
<h2>Настройка рецепта</h2><p>{{> "systems/witcher-eliott-system/templates/item-reference.hbs" recipeDetails.result}} · {{workshop.time}}</p>
<div class="witcher-item-actions"><button type="button" data-action="chooseRecipeResult" {{disabled (not editable)}}>Выбрать результат</button><button type="button" data-action="addRecipeComponent" {{disabled (not editable)}}>Добавить компонент</button></div>
<ul class="witcher-recipe-editor">{{#each workshop.components}}<li>{{#if substance}}<span class="witcher-substance-name">{{#if substanceImg}}<img src="{{substanceImg}}" alt="" width="20" height="20">{{/if}}{{name}}</span>{{else}}{{> "systems/witcher-eliott-system/templates/item-reference.hbs" this showRarity=true}}{{/if}}<b>×{{quantity}}</b><button type="button" data-action="removeRecipeComponent" data-index="{{index}}" aria-label="Удалить компонент: {{name}}" {{disabled (not ../editable)}}><i class="fa-solid fa-xmark"></i></button></li>{{/each}}</ul>
<button type="button" data-action="configureRecipeTools" {{disabled (not editable)}}>Настроить инструменты</button>
{{#if workshop.owned}}<button type="button" data-action="craftRecipe" {{disabled (not editable)}}><i class="fa-solid fa-hammer"></i> Создать по рецепту</button>{{/if}}
{{/if}}
{{#if workshop.repairable}}<button type="button" data-action="repairItem" {{disabled (not editable)}}><i class="fa-solid fa-screwdriver-wrench"></i> Ремонт</button>{{/if}}
{{#if workshop.upgradeable}}<p>Свободные слоты: {{workshop.slots}}</p><button type="button" data-action="installUpgrade" {{disabled (not editable)}}>Установить улучшение</button><button type="button" data-action="installUpgradeDirect" {{disabled (not editable)}}><i class="fa-solid fa-wand-magic-sparkles"></i> Установить без проверки</button><button type="button" data-action="augmentItem" {{disabled (not editable)}}>Модификация ремесленника</button>{{#if workshop.canOil}}<button type="button" data-action="applyOil" {{disabled (not editable)}}>Нанести масло</button>{{/if}}{{/if}}
{{#each workshop.installations}}<p><strong>{{name}}</strong> · {{properties}}{{#if zone}} · {{zoneLabel}}{{/if}} {{#if removable}}<button type="button" data-action="removeArmorUpgrade" data-installation-id="{{id}}" {{disabled (not ../editable)}}>Снять накладку</button>{{/if}}</p>{{/each}}
{{#if workshop.oil}}<p class="witcher-oil"><i class="fa-solid fa-droplet"></i> {{workshop.oil.name}}: +{{workshop.oil.bonus}} против {{workshop.oil.targetLabel}}</p>{{/if}}
{{#if workshop.isMutagen}}{{#if workshop.owned}}<button type="button" data-action="applyMutagen" {{disabled (or (not editable) (not workshop.canApply))}} data-tooltip="Час подготовки, Алхимия по СЛ мутагена, затем постоянный эффект. Не-ведьмаку — мутирование магом или отравление."><i class="fa-solid fa-dna"></i> Принять мутаген</button>{{/if}}{{/if}}
</section>
{{/if}}
