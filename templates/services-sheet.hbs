<div class="witcher-services">
  <header class="witcher-service-header">
    <button type="button" class="witcher-service-portrait" data-action="servicePortrait" aria-label="Изменить изображение заведения" {{disabled (not isGM)}}><img src="{{actor.img}}" alt="{{actor.name}}"></button>
    <div><span class="witcher-service-eyebrow">УСЛУГИ И ПРИСТАНИЩЕ</span><h1>{{actor.name}}</h1><p>{{system.greeting}}</p></div>
    <span class="witcher-service-open {{#if system.closed}}closed{{/if}}">{{#if system.closed}}Закрыто{{else}}Открыто · {{availableCount}}{{/if}}</span>
  </header>
  <nav class="tabs witcher-service-tabs" aria-label="Услуги заведения">{{#each serviceTabs}}<button type="button" data-action="tab" data-group="{{group}}" data-tab="{{id}}" class="{{cssClass}}"><i class="{{icon}}" aria-hidden="true"></i> {{localize label}}{{#if (eq id "orders")}} <span>{{../pendingCount}}</span>{{/if}}</button>{{/each}}</nav>
  <section class="tab {{tabs.catalog.cssClass}} witcher-service-store" data-group="services" data-tab="catalog">
    <div class="witcher-service-catalog"><label class="witcher-service-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Найти услугу…" aria-label="Поиск услуг" data-service-search data-player-control></label>
      {{#each groups}}<section class="witcher-service-group"><h2>{{name}}</h2>{{#each entries}}<button type="button" data-action="selectService" data-service-id="{{id}}" data-service-card class="witcher-service-card {{#if selected}}selected{{/if}}" aria-pressed="{{selected}}"><span><strong>{{name}}</strong><small>{{description}}</small></span><b>{{priceLabel}}</b><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{{else}}<p class="witcher-service-empty">Нет доступных предложений.</p>{{/each}}</section>{{/each}}
    </div>
    <aside class="witcher-service-order-panel">
      {{#if selected}}<span class="witcher-service-eyebrow">ВАШ ЗАКАЗ</span><h2>{{selected.name}}</h2><p>{{selected.description}}</p>{{#if selected.rulesText}}<p class="witcher-service-rules">{{selected.rulesText}}. Стр. 96–97.</p>{{/if}}
      <label>Персонаж<select data-order-field="customer" data-player-control>{{#each customers}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{crowns}}</option>{{else}}<option value="">Нет доступного персонажа</option>{{/each}}</select></label>
      {{#unless isPercent}}<label>Количество · {{selected.unit}}<input type="number" min="1" max="100" step="1" value="{{parameters.quantity}}" data-order-field="quantity" data-player-control></label>{{/unless}}
      {{#if isPercent}}<label>Согласованная выручка, кроны<input type="number" min="0" step="0.01" value="{{parameters.revenue}}" data-order-field="revenue" data-player-control></label>{{/if}}
      {{#if isCraft}}<label>Стоимость одного изделия по чертежу, кроны<input type="number" min="0" step="0.01" value="{{parameters.craftValue}}" data-order-field="craftValue" data-player-control></label><small>Для других работ оставьте 0.</small>{{/if}}
      {{#if isSea}}<label>Маршрут<select data-order-field="route" data-player-control>{{#each routes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · ×{{multiplier}}</option>{{/each}}</select></label>{{/if}}
      {{#if isMedic}}<fieldset class="witcher-service-wounds"><legend>Критические ранения всех пациентов</legend><label>Лёгкие · +10<input type="number" min="0" max="100" value="{{parameters.wounds.simple}}" data-order-field="simple" data-player-control></label><label>Средние · +25<input type="number" min="0" max="100" value="{{parameters.wounds.complex}}" data-order-field="complex" data-player-control></label><label>Тяжёлые · +50<input type="number" min="0" max="100" value="{{parameters.wounds.difficult}}" data-order-field="difficult" data-player-control></label><label>Смертельные · +100<input type="number" min="0" max="100" value="{{parameters.wounds.deadly}}" data-order-field="deadly" data-player-control></label></fieldset>{{/if}}
      <label>Пожелания мастеру<textarea rows="2" maxlength="1000" data-order-field="note" data-player-control>{{note}}</textarea></label>
      <div class="witcher-service-total"><span>Итого</span><strong data-order-total>—</strong></div><small data-order-detail></small>
      <button type="button" class="witcher-service-primary" data-action="sendServiceOrder" data-player-control>Отправить заказ мастеру</button><small>Кроны спишутся только после подтверждения мастером. Выполнение услуги согласуется в игре.</small>
      {{else}}<p>Мастер пока не добавил доступные услуги.</p>{{/if}}
    </aside>
  </section>
  <section class="tab {{tabs.orders.cssClass}} witcher-service-orders" data-group="services" data-tab="orders">
    <h2>{{#if isGM}}Заказы посетителей{{else}}Мои заказы{{/if}}</h2>
    {{#each orders}}<article class="witcher-service-order-card"><header><h3>{{serviceName}}</h3><strong>{{totalLabel}}</strong></header><p>{{customerName}} · {{detail}}</p>{{#if note}}<p class="witcher-service-order-note">{{note}}</p>{{/if}}<footer><span class="order-status {{status}}">{{statusLabel}}</span>{{#if canResolve}}<div><button type="button" data-action="resolveServiceOrder" data-message-id="{{id}}" data-accept="true">Принять и списать кроны</button><button type="button" data-action="resolveServiceOrder" data-message-id="{{id}}" data-accept="false">Отклонить</button></div>{{/if}}</footer></article>{{else}}<div class="witcher-service-empty"><i class="fa-solid fa-receipt" aria-hidden="true"></i><p>Здесь появятся заказы из этого заведения.</p></div>{{/each}}
    {{#if isGM}}<p class="witcher-service-help">Заказы также приходят в личный чат. Принимать их может активный мастер.</p>{{/if}}
  </section>
  {{#if isGM}}<section class="tab {{tabs.manage.cssClass}} witcher-service-manage" data-group="services" data-tab="manage">
    <div class="witcher-service-settings-heading"><label>Название<input type="text" value="{{actor.name}}" data-provider-name></label><label class="witcher-service-check"><input type="checkbox" data-provider-closed {{checked system.closed}}>Закрыто для заказов</label></div>
    <label>Приветствие<input type="text" value="{{system.greeting}}" data-provider-greeting></label>
    <div class="witcher-service-preset"><select aria-label="Пресет услуг" data-preset>{{#each presets}}<option value="{{id}}">{{name}}</option>{{/each}}</select><button type="button" data-action="applyServicePreset">Выбрать ассортимент</button><button type="button" data-action="addCustomService"><i class="fa-solid fa-plus" aria-hidden="true"></i> Своя услуга</button></div>
    <small>Пресет меняет галочки. Ваши цены, описания и собственные услуги сохраняются.</small>
    <div class="witcher-service-settings-list">{{#each settingsEntries}}<details data-service-settings="{{id}}"><summary><input type="checkbox" data-setting="enabled" aria-label="Доступна: {{name}}" {{checked enabled}}><strong>{{name}}</strong><span>{{price}}{{#if percent}}%{{else}} кр.{{/if}} / {{unit}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary><div class="witcher-service-editor"><label>Название<input type="text" value="{{name}}" data-setting="name"></label><label>Цена / процент<input type="number" min="0" step="0.01" value="{{price}}" data-setting="price"></label><label>Расчёт<select data-setting="pricing"><option value="fixed" {{#unless percent}}selected{{/unless}}>Фиксированная цена</option><option value="percent" {{#if percent}}selected{{/if}}>Процент выручки</option></select></label><label>Единица<input type="text" value="{{unit}}" data-setting="unit"></label><label>Раздел<select data-setting="group"><option value="services" {{#unless lodging}}selected{{/unless}}>Услуги</option><option value="lodging" {{#if lodging}}selected{{/if}}>Проживание</option></select></label><label class="wide">Описание<textarea rows="3" data-setting="description">{{description}}</textarea></label>{{#if custom}}<button type="button" data-action="removeCustomService" data-service-id="{{id}}">Удалить свою услугу</button>{{/if}}</div></details>{{/each}}</div>
    <footer><button type="button" class="witcher-service-primary" data-action="saveServiceSettings"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Сохранить ассортимент и цены</button></footer>
  </section>{{/if}}
</div>
