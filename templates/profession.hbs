<div class="witcher-profession-heading">
  <div><small>{{localize "WITCHER.Professions.Tree"}}</small><h2>{{#if profession}}{{profession.name}}{{else}}{{localize "WITCHER.Professions.Title"}}{{/if}}</h2></div>
  {{#if profession}}<button type="button" data-action="toggleProfession" role="switch" aria-checked="{{editingProfession}}" title="{{localize 'WITCHER.Professions.Edit'}}" aria-label="{{localize 'WITCHER.Professions.Edit'}}" {{disabled (not editable)}}><i class="fa-solid {{#if editingProfession}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i> {{localize "WITCHER.Skills.Edit"}}</button>{{/if}}
</div>
{{#if profession}}
{{#if profession.note}}<p class="witcher-profession-info">{{profession.source}} · {{profession.note}}</p>{{/if}}
{{> "systems/witcher-eliott-system/templates/profession-tree.hbs" profession=profession editing=editingProfession editable=editable advancement=false}}
<details class="witcher-profession-info">
  <summary><i class="fa-regular fa-circle-question" aria-hidden="true"></i> {{localize "WITCHER.Professions.Details"}}</summary>
  <p>{{localize "WITCHER.Professions.Advancement"}}</p>
  <p>{{profession.skillNames}}</p>
  {{#if profession.combatSkillNames}}<p>{{localize "WITCHER.Professions.CombatChoices"}}: {{profession.combatSkillNames}}</p>{{/if}}
  {{#if profession.languageChoices}}<p>{{localize "WITCHER.Professions.LanguageChoices"}}: {{profession.languageChoices}}</p>{{/if}}
  <p>{{profession.magic}}</p>
  <p>{{localize "WITCHER.Professions.EquipmentChoices"}}: {{profession.equipmentChoices}}. {{profession.equipment}}</p>
</details>
{{else}}
<div class="witcher-profession-empty"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i><p>{{localize "WITCHER.Professions.Empty"}}</p><button type="button" data-action="chooseReference" data-kind="profession" {{disabled (not editable)}}>{{localize "WITCHER.Professions.Choose"}}</button></div>
{{/if}}
