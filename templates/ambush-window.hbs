<section class="witcher-ambush-content">
  <header class="witcher-ambush-hero"><img src="{{attackerImg}}" alt=""><div><small>ПОДГОТОВКА ЗАСАДЫ</small><h2>{{attackerName}}</h2><p>{{phase}}</p></div><button type="button" data-action="refreshAmbush" data-tooltip="Обновить список" aria-label="Обновить список"><i class="fa-solid fa-arrows-rotate"></i></button></header>
  <div class="witcher-ambush-counts"><div><strong>{{selectedCount}}</strong><span>Отмечено</span></div><div class="is-unnoticed"><strong>{{unnoticedCount}}</strong><span>Не заметили · +5</span></div><div class="is-noticed"><strong>{{noticedCount}}</strong><span>Заметили · без бонуса</span></div></div>
  <div class="witcher-ambush-tools"><label class="witcher-ambush-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-ambush-search value="{{query}}" placeholder="Найти противника…" aria-label="Найти противника"></label><div><button type="button" data-action="selectEnemies" {{disabled (not canSelect)}}>Противники</button><button type="button" data-action="selectAll" {{disabled (not canSelect)}}>Все</button><button type="button" data-action="clearSelection" {{disabled (not canSelect)}}>Снять выбор</button></div></div>
  <div class="witcher-ambush-loadout"><label>Оружие и атака<select data-ambush-weapon {{disabled pending}}>{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{else}}<option value="">Нет оружия в руках</option>{{/each}}</select></label><p>{{#if opening}}Первая атака — один бросок, затем обычная инициатива.{{else}}Бонус засады учитывается отдельно для каждого противника.{{/if}}</p></div>
  <div class="witcher-ambush-roster">
    {{#each rows}}
    <article class="witcher-ambush-enemy {{#if unnoticed}}is-unnoticed{{else}}{{#if noticed}}is-noticed{{/if}}{{/if}}" data-ambush-row data-search="{{search}}">
      <label class="witcher-ambush-enemy-select"><input type="checkbox" data-ambush-select value="{{uuid}}" {{checked selected}} {{disabled disabled}} aria-label="Отметить: {{name}}"><img src="{{img}}" alt=""><span><b>{{name}}</b><small>{{relation}}</small></span></label>
      <div class="witcher-ambush-result"><span><i class="fa-solid {{#if unnoticed}}fa-eye-slash{{else}}fa-eye{{/if}}"></i> {{status}}</span>{{#if unnoticed}}<strong>+5</strong>{{/if}}{{#if canReveal}}<button type="button" data-action="revealTarget" data-target-uuid="{{uuid}}" data-tooltip="Этот противник заметил засадчика">Заметил</button>{{/if}}</div>
      <button type="button" class="witcher-ambush-strike" data-action="ambushStrike" data-target-uuid="{{uuid}}" data-tooltip="{{attackHint}}" {{disabled attackDisabled}}><span><i class="fa-solid fa-khanda"></i> Атаковать <b>{{attackBase}}</b></span><small>{{#if attackReason}}{{attackReason}}{{else}}{{rollCount}} брос. · {{damage}}{{/if}}</small></button>
    </article>
    {{/each}}
    <p class="witcher-ambush-empty" data-ambush-empty>Нет подходящих существ. Игроку доступны только видимые токены на этой сцене.</p>
  </div>
  <footer class="witcher-ambush-footer"><div>{{#if notice}}<p class="witcher-ambush-error" role="alert">{{notice}}</p>{{/if}}{{#if reason}}<p>{{reason}}</p>{{else}}<p>Одна Скрытность против Внимания каждого отмеченного противника.</p>{{/if}}{{#if hasReport}}<small>Кнопка атаки выбирает только её цель. Отметки остальных противников сохраняются.</small>{{/if}}</div><button type="button" class="witcher-ambush-check" data-action="checkAmbush" {{disabled (not canCheck)}}><i class="fa-solid {{#if pending}}fa-hourglass-half{{else}}fa-dice-d10{{/if}}"></i> {{#if pending}}Проверяем…{{else}}{{checkLabel}} · {{selectedCount}}{{/if}}</button></footer>
</section>
